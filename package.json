{
  "name": "weather-sunset-predictor",
  "version": "1.0.0",
  "description": "天气晚霞预测器 - 基于Windy API的火烧云预测应用",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:i18n-hardcoded-zh": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/i18n-hardcoded-zh.test.js"
  },
  "keywords": [
    "weather",
    "sunset",
    "prediction",
    "windy-api"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@dynamicu/chromedebug-mcp": "^2.7.7",
    "@playwright/test": "^1.58.1",
    "axios": "^1.13.4",
    "babel-jest": "^29.7.0",
    "fast-check": "^3.13.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "playwright-mcp": "^0.0.19",
    "supertest": "^7.2.2"
  }
}
