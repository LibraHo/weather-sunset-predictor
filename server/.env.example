# ============================================================
# Windy 孤立开关（Phase 15）
# ------------------------------------------------------------
# ENABLE_WINDY=false（默认）→ Windy 完全不注册，系统仅使用 Open-Meteo
# ENABLE_WINDY=true         → Windy 作为 emergency fallback 可用
#   配合 ENABLE_WINDY_EMERGENCY_FALLBACK=true 自动触发 fallback
#   前端设置面板中的 Windy API Key 输入框也会随之显示
# ============================================================
ENABLE_WINDY=false
ENABLE_WINDY_EMERGENCY_FALLBACK=false

# Windy API Keys Configuration
# Point Forecast API Key - 用于天气预测数据获取（通过后端代理）
# 仅在 ENABLE_WINDY=true 时生效
# 获取方式: https://api.windy.com/
WINDY_API_KEY=your_point_forecast_api_key_here

# Map API Key - 用于Windy地图显示（前端使用）
# 获取方式: https://api.windy.com/ 或 https://stations.windy.com/
WINDY_MAP_API_KEY=your_map_api_key_here

# Gaode (AMap) API Key - 用于国内地理编码（地名搜索/逆地理编码）
# 必填！没有此 key 地理搜索将 fallback 到 Open-Meteo geocoding，国内搜索结果极差
# 获取方式: https://lbs.amap.com/dev/key/app（免费，Web服务类型）
GAODE_API_KEY=your_gaode_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
# 需要与前端的地址匹配，例如: http://127.0.0.1:8080
CORS_ORIGIN=http://localhost:9002

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
