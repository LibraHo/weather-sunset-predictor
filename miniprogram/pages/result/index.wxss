.result-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.meta {
  display: flex;
  gap: 20rpx;
  padding: 22rpx;
}

.meta-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.label {
  color: rgba(255, 255, 255, 0.48);
  font-size: 24rpx;
}

.value {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
}


.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.action-button {
  height: 82rpx;
  margin: 0;
  font-size: 28rpx;
  line-height: 82rpx;
}

.section-head {
  margin-top: 6rpx;
  color: #f5c87a;
  font-size: 30rpx;
  font-weight: 800;
}

.back-button {
  height: 88rpx;
  margin: 8rpx 0 0;
  font-size: 30rpx;
  line-height: 88rpx;
}

.empty-state {
  margin-top: 20vh;
  padding: 42rpx 32rpx;
  text-align: center;
}

.empty-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 900;
}

.empty-copy {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 27rpx;
  line-height: 1.55;
}

.empty-button {
  width: 100%;
  margin-top: 32rpx;
}
