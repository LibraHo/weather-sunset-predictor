.result-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.result-prediction-toggle {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  box-sizing: border-box;
  padding: 8rpx;
  border: 2rpx solid rgba(127, 83, 29, 0.10);
  border-radius: 999rpx;
  background: rgba(255, 252, 246, 0.72);
  overflow: hidden;
}

.result-period-option {
  min-width: 0;
  min-height: 56rpx;
  box-sizing: border-box;
  padding: 0 8rpx;
  border-radius: 999rpx;
  color: rgba(89, 67, 54, 0.62);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 56rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-period-option.active {
  color: #ffffff;
  background: linear-gradient(135deg, #f59e0b, #ea8500);
}

.result-page.theme-dark .result-prediction-toggle {
  border-color: rgba(255, 255, 255, 0.10);
  background: rgba(7, 16, 31, 0.58);
}

.result-page.theme-dark .result-period-option {
  color: rgba(255, 255, 255, 0.62);
}

.result-page.theme-dark .result-period-option.active {
  color: #1b1206;
}

.result-summary-row {
  display: flex;
  gap: 16rpx;
}

.meta-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: rgba(18, 28, 52, 0.46);
}

.label {
  color: rgba(255, 255, 255, 0.48);
  font-size: 24rpx;
}

.value {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
}


.action-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.result-share-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 82rpx;
  margin: 0;
  min-width: 0;
  padding: 0 16rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(217, 119, 6, 0.24);
  border-radius: 999rpx;
  color: #1b1206;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
}

.result-action-label {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

.result-share-action::after {
  border: 0;
}

.result-share-primary {
  background: linear-gradient(135deg, rgba(255, 209, 102, 0.96), rgba(251, 146, 60, 0.96));
  box-shadow: 0 16rpx 34rpx rgba(217, 119, 6, 0.18);
}

.result-feedback-action {
  padding: 0 14rpx;
  background: rgba(255, 252, 246, 0.9);
  color: #4b3621;
}

.result-favorite-action {
  background: rgba(255, 252, 246, 0.14);
  color: rgba(255, 255, 255, 0.82);
  border-color: rgba(255, 255, 255, 0.12);
}

.share-icon-image {
  flex: none;
  width: 36rpx;
  height: 36rpx;
}

.feedback-icon-image {
  flex: none;
  width: 38rpx;
  height: 38rpx;
}

.result-action-label {
  flex: 0 1 auto;
  min-width: 0;
  color: inherit;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-favorite-label {
  max-width: 100%;
  font-size: 25rpx;
}

.result-page.theme-dark .result-feedback-action {
  color: rgba(255, 247, 237, 0.90);
  border-color: rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.08);
}

.result-page.theme-dark .result-favorite-action {
  color: rgba(255, 255, 255, 0.76);
  border-color: rgba(255, 255, 255, 0.10);
  background: rgba(255, 255, 255, 0.06);
}

.result-view-switch {
  padding: 0 2rpx;
}

.switch-title {
  color: rgba(255, 255, 255, 0.48);
  font-size: 22rpx;
  font-weight: 800;
}

.switch-options {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
  overflow-x: auto;
}

.switch-option {
  flex: 0 0 auto;
  min-width: 108rpx;
  height: 58rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 58rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.06);
}

.section-head {
  margin-top: 6rpx;
  color: #f5c87a;
  font-size: 28rpx;
  font-weight: 800;
}

.score-ledger-card {
  position: relative;
  overflow: hidden;
  padding: 28rpx;
  border: 2rpx solid rgba(127, 83, 29, 0.15);
  border-radius: 24rpx;
  background: rgba(255, 252, 246, 0.88);
  box-shadow: 0 28rpx 76rpx rgba(92, 58, 20, 0.10), inset 0 1rpx 0 rgba(255, 255, 255, 0.88);
}

.score-ledger-card::before {
  content: "";
  position: absolute;
  top: -120rpx;
  right: -100rpx;
  width: 300rpx;
  height: 240rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 209, 102, 0.26), rgba(251, 146, 60, 0.04));
}

.score-ledger-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.score-ledger-title {
  color: #3d3028;
  font-size: 30rpx;
  font-weight: 900;
}

.score-ledger-subtitle {
  color: rgba(89, 67, 54, 0.62);
  font-size: 24rpx;
  font-weight: 700;
}

.score-ledger-summary {
  position: relative;
  margin-top: 16rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(127, 83, 29, 0.12);
  border-radius: 16rpx;
  color: #4b392b;
  font-size: 25rpx;
  line-height: 1.52;
  font-weight: 760;
  background: rgba(255, 255, 255, 0.54);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.76);
}

.score-ledger-steps {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 16rpx;
}

.score-ledger-step {
  display: flex;
  gap: 14rpx;
  padding: 16rpx 16rpx 16rpx 14rpx;
  border: 1rpx solid rgba(127, 83, 29, 0.12);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.48);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.70);
}

.score-ledger-step-final {
  border-color: rgba(251, 146, 60, 0.32);
  background: rgba(255, 237, 213, 0.68);
}

.score-ledger-index {
  flex: 0 0 42rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  color: #6a421d;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 42rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 8rpx 18rpx rgba(92, 58, 20, 0.08);
}

.score-ledger-body {
  flex: 1;
  min-width: 0;
}

.score-ledger-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.score-ledger-label {
  color: #3d3028;
  font-size: 25rpx;
  font-weight: 900;
}

.score-ledger-result {
  flex: 0 0 auto;
  color: #c96b18;
  font-size: 26rpx;
  font-weight: 900;
}

.score-ledger-expression,
.score-ledger-detail {
  margin-top: 10rpx;
  color: rgba(89, 67, 54, 0.72);
  font-size: 24rpx;
  line-height: 1.5;
}

.score-ledger-detail {
  padding: 10rpx 12rpx;
  border: 1rpx solid rgba(127, 83, 29, 0.10);
  border-radius: 14rpx;
  color: rgba(89, 67, 54, 0.62);
  background: rgba(255, 252, 246, 0.58);
}

.result-page.theme-dark .score-ledger-card {
  border-color: rgba(255, 255, 255, 0.12);
  background: rgba(12, 21, 39, 0.78);
  box-shadow: 0 28rpx 76rpx rgba(0, 0, 0, 0.24), inset 0 1rpx 0 rgba(255, 255, 255, 0.10);
}

.result-page.theme-dark .score-ledger-card::before {
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.22), rgba(14, 165, 233, 0.04));
}

.result-page.theme-dark .score-ledger-title {
  color: rgba(255, 247, 237, 0.96);
}

.result-page.theme-dark .score-ledger-subtitle {
  color: rgba(255, 255, 255, 0.58);
}

.result-page.theme-dark .score-ledger-summary {
  border-color: rgba(255, 255, 255, 0.10);
  color: rgba(255, 255, 255, 0.86);
  background: rgba(255, 255, 255, 0.08);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.10);
}

.result-page.theme-dark .score-ledger-step {
  border-color: rgba(255, 255, 255, 0.10);
  background: rgba(255, 255, 255, 0.07);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.result-page.theme-dark .score-ledger-step-final {
  border-color: rgba(251, 146, 60, 0.38);
  background: rgba(251, 146, 60, 0.12);
}

.result-page.theme-dark .score-ledger-index {
  color: #fbbf24;
  background: rgba(255, 255, 255, 0.10);
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.18);
}

.result-page.theme-dark .score-ledger-label {
  color: rgba(255, 247, 237, 0.94);
}

.result-page.theme-dark .score-ledger-result {
  color: #fbbf24;
}

.result-page.theme-dark .score-ledger-expression,
.result-page.theme-dark .score-ledger-detail {
  color: rgba(255, 255, 255, 0.66);
}

.result-page.theme-dark .score-ledger-detail {
  border-color: rgba(255, 255, 255, 0.09);
  background: rgba(15, 23, 42, 0.54);
}

.analysis-card,
.radar-card,
.three-day-card {
  padding: 24rpx;
}

.analysis-lead {
  color: rgba(255, 255, 255, 0.78);
  font-size: 27rpx;
  line-height: 1.62;
}

.analysis-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 20rpx;
}

.analysis-item {
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: rgba(7, 16, 31, 0.50);
}

.analysis-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.analysis-title {
  color: rgba(255, 255, 255, 0.76);
  font-size: 25rpx;
  font-weight: 800;
}

.analysis-status-label {
  flex: none;
  max-width: 96rpx;
  box-sizing: border-box;
  padding: 4rpx 10rpx;
  border: 1rpx solid rgba(245, 200, 122, 0.18);
  border-radius: 999rpx;
  color: rgba(245, 200, 122, 0.90);
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: rgba(245, 200, 122, 0.08);
}

.tone-excellent .analysis-status-label {
  border-color: rgba(251, 191, 36, 0.34);
  color: #facc15;
  background: rgba(251, 191, 36, 0.12);
}

.tone-good .analysis-status-label {
  border-color: rgba(34, 197, 94, 0.28);
  color: #86efac;
  background: rgba(34, 197, 94, 0.12);
}

.tone-watch .analysis-status-label {
  border-color: rgba(245, 158, 11, 0.26);
  color: #fbbf24;
  background: rgba(245, 158, 11, 0.12);
}

.tone-weak .analysis-status-label,
.tone-unknown .analysis-status-label {
  border-color: rgba(248, 113, 113, 0.28);
  color: #fca5a5;
  background: rgba(239, 68, 68, 0.12);
}

.analysis-detail {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.54);
  font-size: 24rpx;
  line-height: 1.5;
}

.tone-excellent {
  border-color: rgba(251, 191, 36, 0.36);
  background: rgba(251, 146, 60, 0.13);
}

.tone-good {
  border-color: rgba(250, 204, 21, 0.28);
  background: rgba(202, 138, 4, 0.12);
}

.tone-watch {
  border-color: rgba(56, 189, 248, 0.26);
  background: rgba(14, 116, 144, 0.12);
}

.tone-weak,
.tone-unknown {
  border-color: rgba(148, 163, 184, 0.16);
  background: rgba(15, 23, 42, 0.48);
}

.tone-center {
  border-color: rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.08);
}

.panel-loading,
.panel-error,
.panel-empty {
  padding: 22rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(7, 16, 31, 0.50);
}

.loading-copy,
.panel-empty {
  color: rgba(255, 255, 255, 0.58);
  font-size: 25rpx;
}

.panel-error {
  color: #fecaca;
  font-size: 25rpx;
}

.loading-track {
  height: 8rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.10);
}

.loading-fill {
  width: 46%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #ffd166, #fb923c);
}

.radar-compass-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.radar-compass-title {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}

.radar-compass-subtitle {
  color: rgba(255, 255, 255, 0.46);
  font-size: 22rpx;
  font-weight: 700;
}

.radar-compass-dial {
  position: relative;
  width: 470rpx;
  height: 470rpx;
  max-width: 100%;
  margin: 24rpx auto 10rpx;
  border-radius: 50%;
  overflow: visible;
}

.radar-cloud-field {
  position: absolute;
  inset: 0;
  overflow: visible;
}

.radar-cloud-canvas {
  position: absolute;
  inset: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0.98;
}

.radar-ring-label {
  position: absolute;
  color: rgba(255, 255, 255, 0.46);
  font-size: 21rpx;
  font-weight: 800;
  z-index: 2;
  transform: translate(-50%, -50%);
}

.radar-ring-label-low { left: 44.7%; top: 35.4%; }
.radar-ring-label-mid { left: 41.1%; top: 25.6%; }
.radar-ring-label-high { left: 37.3%; top: 15.2%; }

.radar-ring,
.radar-axis,
.radar-center-dot,
.radar-direction,
.radar-sun-event-icon {
  position: absolute;
}

.radar-ring {
  left: 50%;
  top: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.radar-ring-outer {
  width: 84%;
  height: 84%;
}

.radar-ring-middle {
  width: 64%;
  height: 64%;
}

.radar-ring-inner {
  width: 40%;
  height: 40%;
}

.radar-ring-low-inner {
  width: 22%;
  height: 22%;
}

.radar-axis {
  left: 50%;
  top: 6.3%;
  width: 1rpx;
  height: 87.4%;
  background: rgba(255, 255, 255, 0.10);
  transform-origin: center;
}

.axis-ew { transform: rotate(90deg); }
.axis-ne-sw { transform: rotate(45deg); }
.axis-nw-se { transform: rotate(-45deg); }

.radar-center-dot {
  left: 50%;
  top: 50%;
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 50%;
  background: #fb923c;
  box-shadow: 0 0 28rpx rgba(251, 146, 60, 0.46);
  transform: translate(-50%, -50%);
}

.radar-sun-event-icon {
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  color: #fb923c;
  transform: translate(-50%, -50%);
}

.radar-sun-event-symbol {
  width: 42rpx;
  height: 42rpx;
  border: 2rpx solid rgba(251, 146, 60, 0.58);
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 40rpx;
  text-align: center;
  background: rgba(7, 16, 31, 0.72);
}

.radar-sun-event-label {
  color: rgba(255, 255, 255, 0.60);
  font-size: 20rpx;
  font-weight: 800;
}

.radar-direction {
  width: 86rpx;
  text-align: center;
  transform: translate(-50%, -50%);
}

.radar-direction-N { left: 50%; top: 4.6%; }
.radar-direction-NE { left: 82.1%; top: 17.9%; }
.radar-direction-E { left: 95.4%; top: 50%; }
.radar-direction-SE { left: 82.1%; top: 82.1%; }
.radar-direction-S { left: 50%; top: 95.4%; }
.radar-direction-SW { left: 17.9%; top: 82.1%; }
.radar-direction-W { left: 4.6%; top: 50%; }
.radar-direction-NW { left: 17.9%; top: 17.9%; }

.radar-direction-name {
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
  font-weight: 800;
}

.radar-legend {
  display: flex;
  justify-content: center;
  gap: 22rpx;
  margin-top: 12rpx;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
}

.radar-legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: rgba(255, 255, 255, 0.60);
  font-size: 21rpx;
  font-weight: 700;
}

.legend-cloud {
  width: 22rpx;
  height: 12rpx;
  border-radius: 50%;
}

.legend-cloud.low { background: rgba(138, 156, 186, 0.95); }
.legend-cloud.mid { background: rgba(184, 198, 218, 0.88); }
.legend-cloud.high { background: rgba(218, 226, 238, 0.72); }

.three-day-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.three-day-note {
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.56);
  font-size: 22rpx;
  line-height: 1.45;
}

.day-row {
  display: grid;
  grid-template-columns: 1.1fr 1fr 1fr;
  gap: 12rpx;
  align-items: stretch;
}

.day-meta,
.day-score {
  min-height: 92rpx;
  box-sizing: border-box;
  padding: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: rgba(7, 16, 31, 0.50);
}

.day-label {
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 900;
}

.day-date {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.44);
  font-size: 22rpx;
}

.day-score {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.day-score-label {
  color: rgba(255, 255, 255, 0.62);
  font-size: 23rpx;
  font-weight: 700;
}

.day-score-value {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
}

.back-button {
  height: 88rpx;
  margin: 8rpx 0 0;
  font-size: 30rpx;
  line-height: 88rpx;
}

.empty-state {
  margin-top: 20vh;
  padding: 42rpx 32rpx;
  text-align: center;
}

.empty-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 900;
}

.empty-copy {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 27rpx;
  line-height: 1.55;
}

.empty-button {
  width: 100%;
  margin-top: 32rpx;
}

.feedback-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: flex-end;
  padding: 28rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.46);
}

.feedback-sheet {
  width: 100%;
  max-height: 86vh;
  overflow: auto;
  padding: 30rpx;
  border-radius: 18rpx;
}

.feedback-title {
  color: #fff;
  font-size: 34rpx;
  font-weight: 900;
}

.feedback-help {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 24rpx;
  line-height: 1.55;
}

.feedback-type-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 22rpx;
}

.feedback-type {
  min-height: 110rpx;
  padding: 14rpx 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 14rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: 900;
  text-align: center;
  background: rgba(255, 255, 255, 0.06);
}

.feedback-type.active {
  border-color: rgba(251, 146, 60, 0.72);
  background: rgba(251, 146, 60, 0.16);
}

.feedback-type text {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.56);
  font-size: 20rpx;
  font-weight: 700;
}

.feedback-input {
  width: 100%;
  min-height: 78rpx;
  margin-top: 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 14rpx;
  color: #fff;
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.08);
}

.feedback-textarea {
  min-height: 148rpx;
  padding-top: 18rpx;
}

.feedback-image-row {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.feedback-image,
.feedback-add-image {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.08);
}

.feedback-image image {
  width: 100%;
  height: 100%;
}

.feedback-image text {
  position: absolute;
  top: 6rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  color: #fff;
  line-height: 34rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.58);
}

.feedback-add-image {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  font-weight: 800;
}

.feedback-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 22rpx;
}
