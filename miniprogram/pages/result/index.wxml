<view class="container result-page theme-{{resolvedThemeMode}}">
  <app-topbar current="result" period="{{activePeriod}}" theme-mode="{{themeMode}}" resolved-theme-mode="{{resolvedThemeMode}}" bind:settingschange="onAppSettingsChange" />
  <block wx:if="{{hasPrediction}}">
    <view class="result-prediction-toggle">
      <view class="result-period-option tap-feedback {{activePeriod === 'sunrise' ? 'active' : ''}}" data-period="sunrise" bindtap="selectResultPeriod" hover-class="tap-feedback-hover" hover-stay-time="80">朝霞</view>
      <view class="result-period-option tap-feedback {{activePeriod === 'sunset' ? 'active' : ''}}" data-period="sunset" bindtap="selectResultPeriod" hover-class="tap-feedback-hover" hover-stay-time="80">晚霞</view>
    </view>

    <score-hero score="{{prediction.score}}" grade="{{prediction.grade}}" location-name="{{prediction.locationName}}" period="{{prediction.period}}" best-window="{{prediction.bestWindow}}" explanation="{{prediction.explanation}}" />

    <view class="result-summary-row">
      <view class="meta-item">
        <text class="label">日期</text>
        <text class="value">{{prediction.dayLabel}}</text>
      </view>
      <view class="meta-item">
        <text class="label">类型</text>
        <text class="value">{{prediction.periodLabel}}</text>
      </view>
    </view>

    <view class="action-row">
      <button class="result-share-action result-share-primary" open-type="share" aria-label="分享霞光评分" hover-class="button-hover" hover-stay-time="80">
        <image class="share-icon-image" src="/assets/icons/share-upload.svg" mode="aspectFit" aria-hidden="true" />
        <text class="result-action-label">分享</text>
      </button>
      <button class="result-share-action result-feedback-action" bindtap="openFeedback" aria-label="反馈预测结果" hover-class="button-hover" hover-stay-time="80">
        <image class="feedback-icon-image" src="/assets/icons/feedback-message.svg" mode="aspectFit" aria-hidden="true" />
        <text class="result-action-label">反馈</text>
      </button>
      <button class="result-share-action result-favorite-action" bindtap="toggleFavorite" hover-class="button-hover" hover-stay-time="80">{{isFavorite ? '取消收藏' : '收藏地点'}}</button>
    </view>

    <view wx:if="{{feedbackModalVisible}}" class="feedback-mask" bindtap="closeFeedback">
      <view class="feedback-sheet xiake-card" catchtap="noop">
        <view class="feedback-title">反馈预测结果</view>
        <view class="feedback-help">反馈只在日出/日落前 1 小时到事件后 45 分钟内开放。</view>
        <view class="feedback-type-row">
          <view class="feedback-type {{feedbackForm.feedbackType === 'missed' ? 'active' : ''}}" data-type="missed" bindtap="updateFeedbackType">漏报<text>实际很好但分低</text></view>
          <view class="feedback-type {{feedbackForm.feedbackType === 'wrong' ? 'active' : ''}}" data-type="wrong" bindtap="updateFeedbackType">误报<text>实际不好但分高</text></view>
          <view class="feedback-type {{feedbackForm.feedbackType === 'overstated' ? 'active' : ''}}" data-type="overstated" bindtap="updateFeedbackType">虚报<text>有颜色但不值冲</text></view>
        </view>
        <textarea class="feedback-input feedback-textarea" placeholder="评论：描述现场云量、颜色、遮挡和时间" data-field="comment" value="{{feedbackForm.comment}}" bindinput="updateFeedbackField" />
        <input class="feedback-input" placeholder="昵称" data-field="nickname" value="{{feedbackForm.nickname}}" bindinput="updateFeedbackField" />
        <input class="feedback-input" placeholder="邮箱" data-field="contactEmail" value="{{feedbackForm.contactEmail}}" bindinput="updateFeedbackField" />
        <view class="feedback-image-row">
          <view class="feedback-image" wx:for="{{feedbackImages}}" wx:key="path">
            <image src="{{item.path}}" mode="aspectFill" />
            <text data-index="{{index}}" bindtap="removeFeedbackImage">×</text>
          </view>
          <view wx:if="{{feedbackImages.length < 2}}" class="feedback-add-image" bindtap="chooseFeedbackImages">+ 图片</view>
        </view>
        <view class="feedback-actions">
          <button class="ghost-button action-button" bindtap="closeFeedback">取消</button>
          <button class="primary-button action-button" loading="{{feedbackSubmitting}}" bindtap="submitFeedbackForm">提交反馈</button>
        </view>
      </view>
    </view>

    <view class="score-ledger-card xiake-card">
      <view class="score-ledger-hero">
        <view class="score-ledger-title">为什么是这个分数</view>
        <view class="score-ledger-subtitle">对齐网页版评分解释</view>
      </view>
      <view class="score-ledger-summary">{{scoreLedger.summary}}</view>
      <view class="score-ledger-steps">
        <view class="score-ledger-step score-ledger-step-{{item.tone}}" wx:for="{{scoreLedger.steps}}" wx:key="key">
          <text class="score-ledger-index">{{index + 1}}</text>
          <view class="score-ledger-body">
            <view class="score-ledger-line">
              <text class="score-ledger-label">{{item.label}}</text>
              <text class="score-ledger-result">{{item.result}}</text>
            </view>
            <view class="score-ledger-expression" wx:if="{{item.expression}}">{{item.expression}}</view>
            <view class="score-ledger-detail" wx:if="{{item.detail}}">{{item.detail}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="result-view-switch">
      <view class="switch-title">继续查看</view>
      <view class="switch-options">
        <view class="switch-option tap-feedback" data-target="map" bindtap="navigateExperience" hover-class="tap-feedback-hover" hover-stay-time="80">地图</view>
        <view class="switch-option tap-feedback" data-target="methodology" bindtap="navigateExperience" hover-class="tap-feedback-hover" hover-stay-time="80">算法</view>
        <view class="switch-option tap-feedback" data-target="gallery" bindtap="navigateExperience" hover-class="tap-feedback-hover" hover-stay-time="80">照片</view>
        <view class="switch-option tap-feedback" data-target="api" bindtap="navigateExperience" hover-class="tap-feedback-hover" hover-stay-time="80">API</view>
        <view class="switch-option tap-feedback" data-target="upload" bindtap="navigateExperience" hover-class="tap-feedback-hover" hover-stay-time="80">上传</view>
      </view>
    </view>

    <view class="section-head">关键天气因子</view>
    <metric-grid metrics="{{metrics}}" />

    <view class="section-head">火烧云文字分析</view>
    <view class="analysis-card result-analysis-card">
      <view class="analysis-lead">{{prediction.explanation}}</view>
      <view class="analysis-grid">
        <view class="analysis-item tone-{{item.tone}}" wx:for="{{analysisItems}}" wx:key="key">
          <view class="analysis-topline">
            <text class="analysis-title">{{item.title}}</text>
            <text class="analysis-status-label">{{item.status}}</text>
          </view>
          <view class="analysis-detail">{{item.detail}}</view>
        </view>
      </view>
    </view>

    <view class="section-head">周边云况雷达</view>
    <view class="radar-card xiake-card">
      <view wx:if="{{radar.loading}}" class="panel-loading">
        <view class="loading-copy">正在读取周边 8 方向云况</view>
        <view class="loading-track"><view class="loading-fill"></view></view>
      </view>
      <view wx:elif="{{radar.error}}" class="panel-error">{{radar.error}}</view>
      <view wx:elif="{{radar.hasData}}" class="radar-compass">
        <view class="radar-compass-head">
          <view class="radar-compass-title">周边云况雷达</view>
          <view class="radar-compass-subtitle">25km · 8方向</view>
          </view>
          <view class="radar-compass-dial">
            <view class="radar-cloud-field">
              <canvas id="resultRadarCloudField" canvas-id="resultRadarCloudField" type="2d" class="radar-cloud-canvas" disable-scroll="true"></canvas>
            </view>
          <view class="radar-ring-label radar-ring-label-{{item.className}}" wx:for="{{radar.rings}}" wx:key="key">{{item.label}}</view>
            <view class="radar-ring radar-ring-outer"></view>
            <view class="radar-ring radar-ring-middle"></view>
            <view class="radar-ring radar-ring-inner"></view>
            <view class="radar-ring radar-ring-low-inner"></view>
          <view class="radar-axis axis-ns"></view>
          <view class="radar-axis axis-ew"></view>
          <view class="radar-axis axis-ne-sw"></view>
          <view class="radar-axis axis-nw-se"></view>
          <view class="radar-sun-event-icon radar-sun-event-icon-{{item.type}}" wx:for="{{radar.sunEvents}}" wx:key="key" style="left: {{item.left}}%; top: {{item.top}}%;">
            <text class="radar-sun-event-symbol">{{item.type === 'sunrise' ? '↗' : '↘'}}</text>
            <text class="radar-sun-event-label">{{item.label}}</text>
          </view>
          <view class="radar-center-dot"></view>
          <view class="radar-direction radar-direction-{{item.direction}}" wx:for="{{radar.directions}}" wx:key="direction">
            <view class="radar-direction-name">{{item.name}}</view>
          </view>
        </view>
        <view class="radar-legend">
          <view class="radar-legend-item"><view class="legend-cloud low"></view><text>低云</text></view>
          <view class="radar-legend-item"><view class="legend-cloud mid"></view><text>中云</text></view>
          <view class="radar-legend-item"><view class="legend-cloud high"></view><text>高云</text></view>
        </view>
      </view>
      <view wx:else class="panel-empty">这个地点暂时没有周边云况数据。</view>
    </view>

    <view class="section-head">3 天预测</view>
    <view class="three-day-card xiake-card">
      <view wx:if="{{threeDayGlow.loading}}" class="panel-loading">
        <view class="loading-copy">正在计算未来 3 天朝霞 / 晚霞</view>
        <view class="loading-track"><view class="loading-fill"></view></view>
      </view>
      <view wx:elif="{{threeDayGlow.error}}" class="panel-error">{{threeDayGlow.error}}</view>
      <view wx:elif="{{threeDayGlow.hasData}}" class="three-day-list">
        <view class="day-row" wx:for="{{threeDayGlow.days}}" wx:key="key">
          <view class="day-meta">
            <view class="day-label">{{item.label}}</view>
            <view class="day-date">{{item.date}}</view>
          </view>
          <view class="day-score tone-{{item.sunriseLevel}}">
            <text class="day-score-label">朝霞</text>
            <text class="day-score-value">{{item.sunriseScoreText}}</text>
          </view>
          <view class="day-score tone-{{item.sunsetLevel}}">
            <text class="day-score-label">晚霞</text>
            <text class="day-score-value">{{item.sunsetScoreText}}</text>
          </view>
        </view>
        <view class="three-day-note">超过一天后的概率可能不准，仅供参考。</view>
      </view>
      <view wx:else class="panel-empty">这个地点暂时没有三天预测数据。</view>
    </view>

    <button class="ghost-button back-button" bindtap="goHome" hover-class="button-hover" hover-stay-time="80">重新查分</button>
  </block>

  <view class="empty-state xiake-card" wx:else>
    <view class="empty-title">还没有可展示的分数</view>
    <view class="empty-copy">请先回首页选择地点和日期，完成一次查分。</view>
    <button class="primary-button empty-button" bindtap="goHome" hover-class="button-hover" hover-stay-time="80">返回首页</button>
  </view>
</view>
