.home-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.home-topbar {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  padding: 4rpx 4rpx 0;
}

.home-hero {
  position: relative;
  padding: 4rpx 6rpx 4rpx;
  overflow: hidden;
}

.home-hero::after {
  content: "";
  position: absolute;
  right: -120rpx;
  top: 8rpx;
  width: 320rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(110deg, rgba(255, 209, 102, 0.20), rgba(251, 146, 60, 0.04));
  opacity: 0.9;
  transform: rotate(-12deg);
}

.home-brand-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.app-logo-mark {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  color: #f5c87a;
}

.logo-sun {
  position: absolute;
  left: 10rpx;
  top: 8rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: currentColor;
}

.logo-line {
  position: absolute;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.logo-line-1 {
  left: 2rpx;
  right: 2rpx;
  top: 32rpx;
}

.logo-line-2 {
  left: 12rpx;
  right: 12rpx;
  top: 39rpx;
  height: 3rpx;
}

.app-logo-text {
  color: #f5c87a;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 0;
  line-height: 1;
}

.home-view-menu {
  position: relative;
}

.menu-button {
  width: 56rpx;
  height: 44rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 36rpx;
  background: rgba(255, 255, 255, 0.06);
}

.home-view-menu-dropdown {
  position: absolute;
  top: 54rpx;
  right: 0;
  width: 236rpx;
  box-sizing: border-box;
  padding: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  background: rgba(10, 15, 30, 0.96);
  box-shadow: 0 18rpx 46rpx rgba(0, 0, 0, 0.34);
}

.home-title {
  position: relative;
  z-index: 1;
  max-width: 620rpx;
  margin-top: 22rpx;
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.14;
}

.home-subtitle {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 27rpx;
  line-height: 1.5;
}

.home-view-option {
  min-height: 56rpx;
  box-sizing: border-box;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 32rpx;
}

.home-view-option.active {
  color: #1b1206;
  font-weight: 800;
  background: linear-gradient(135deg, #ffd166, #fb923c);
}

.home-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.control-card {
  padding: 26rpx;
}

.section-title {
  color: rgba(255, 255, 255, 0.66);
  font-size: 26rpx;
  font-weight: 700;
}

.date-title {
  margin-top: 26rpx;
}

.segmented {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: rgba(7, 16, 31, 0.58);
}

.segment {
  flex: 1;
  height: 74rpx;
  border-radius: 12rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 74rpx;
  text-align: center;
}

.segment.active {
  color: #1b1206;
  background: linear-gradient(135deg, #ffd166, #fb923c);
}

.query-button {
  width: 100%;
  margin: 0;
}

.error-card {
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(248, 113, 113, 0.28);
  border-radius: 14rpx;
  color: #fecaca;
  background: rgba(127, 29, 29, 0.26);
  font-size: 26rpx;
}

.placeholder-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.section-hint {
  max-width: 360rpx;
  color: rgba(255, 255, 255, 0.42);
  font-size: 22rpx;
  line-height: 1.45;
  text-align: right;
}

.mini-card {
  min-height: 210rpx;
  padding: 22rpx;
}

.mini-head {
  color: #f5c87a;
  font-size: 28rpx;
  font-weight: 800;
}

.query-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 18rpx;
  color: #ffffff;
  font-size: 25rpx;
}

.empty {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.44);
  font-size: 25rpx;
  line-height: 1.5;
}
