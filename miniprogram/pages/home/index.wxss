.home-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.app-header {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 26rpx;
  background: linear-gradient(120deg, rgba(18, 28, 52, 0.78), rgba(251, 146, 60, 0.10));
}

.app-logo {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.app-logo-mark {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  color: #f5c87a;
}

.logo-arc {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  width: 48rpx;
  height: 40rpx;
  border-top: 5rpx solid currentColor;
  border-left: 5rpx solid currentColor;
  border-right: 5rpx solid currentColor;
  border-radius: 48rpx 48rpx 0 0;
}

.logo-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 5rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.logo-line-1 {
  top: 43rpx;
}

.logo-line-2 {
  left: 10rpx;
  right: 10rpx;
  top: 55rpx;
  height: 4rpx;
}

.logo-line-3 {
  left: 22rpx;
  right: 22rpx;
  top: 66rpx;
  height: 3rpx;
}

.app-logo-text {
  color: #f5c87a;
  font-size: 40rpx;
  font-weight: 300;
  letter-spacing: 0.08em;
  line-height: 1;
}

.home-view-menu {
  position: relative;
}

.menu-button {
  width: 80rpx;
  height: 80rpx;
  margin: 0;
  border: 1rpx solid rgba(251, 191, 36, 0.18);
  border-radius: 14rpx;
  color: #f5c87a;
  font-size: 34rpx;
  line-height: 80rpx;
  background: rgba(251, 146, 60, 0.10);
}

.home-view-menu-dropdown {
  position: absolute;
  top: 92rpx;
  right: 0;
  width: 324rpx;
  box-sizing: border-box;
  padding: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 18rpx;
  background: rgba(18, 28, 52, 0.96);
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.36);
}

.home-view-option {
  min-height: 68rpx;
  box-sizing: border-box;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 27rpx;
  line-height: 36rpx;
}

.home-view-option.active {
  color: #1b1206;
  font-weight: 800;
  background: linear-gradient(135deg, #ffd166, #fb923c);
}

.hero-copy {
  padding: 0 6rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 28rpx;
  line-height: 1.5;
}

.home-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.control-card {
  padding: 26rpx;
}

.section-title {
  color: rgba(255, 255, 255, 0.66);
  font-size: 26rpx;
  font-weight: 700;
}

.date-title {
  margin-top: 26rpx;
}

.segmented {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: rgba(7, 16, 31, 0.58);
}

.segment {
  flex: 1;
  height: 74rpx;
  border-radius: 12rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 74rpx;
  text-align: center;
}

.segment.active {
  color: #1b1206;
  background: linear-gradient(135deg, #ffd166, #fb923c);
}

.query-button {
  width: 100%;
  margin: 0;
}

.error-card {
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(248, 113, 113, 0.28);
  border-radius: 14rpx;
  color: #fecaca;
  background: rgba(127, 29, 29, 0.26);
  font-size: 26rpx;
}

.placeholder-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.section-hint {
  max-width: 360rpx;
  color: rgba(255, 255, 255, 0.42);
  font-size: 22rpx;
  line-height: 1.45;
  text-align: right;
}

.mini-card {
  min-height: 210rpx;
  padding: 22rpx;
}

.mini-head {
  color: #f5c87a;
  font-size: 28rpx;
  font-weight: 800;
}

.query-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 18rpx;
  color: #ffffff;
  font-size: 25rpx;
}

.empty {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.44);
  font-size: 25rpx;
  line-height: 1.5;
}
