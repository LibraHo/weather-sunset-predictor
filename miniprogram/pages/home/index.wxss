.home-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hero {
  padding: 12rpx 6rpx 8rpx;
}

.brand {
  font-size: 34rpx;
}

.headline {
  margin-top: 18rpx;
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.18;
}

.caption {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 27rpx;
}

.control-card {
  padding: 26rpx;
}

.section-title {
  color: rgba(255, 255, 255, 0.66);
  font-size: 26rpx;
  font-weight: 700;
}

.date-title {
  margin-top: 26rpx;
}

.segmented {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: rgba(7, 16, 31, 0.58);
}

.segment {
  flex: 1;
  height: 74rpx;
  border-radius: 12rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 74rpx;
  text-align: center;
}

.segment.active {
  color: #1b1206;
  background: linear-gradient(135deg, #ffd166, #fb923c);
}

.query-button {
  width: 100%;
  margin: 0;
}

.error-card {
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(248, 113, 113, 0.28);
  border-radius: 14rpx;
  color: #fecaca;
  background: rgba(127, 29, 29, 0.26);
  font-size: 26rpx;
}

.placeholder-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.mini-card {
  min-height: 210rpx;
  padding: 22rpx;
}

.mini-head {
  color: #f5c87a;
  font-size: 28rpx;
  font-weight: 800;
}

.query-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 18rpx;
  color: #ffffff;
  font-size: 25rpx;
}

.empty {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.44);
  font-size: 25rpx;
  line-height: 1.5;
}
