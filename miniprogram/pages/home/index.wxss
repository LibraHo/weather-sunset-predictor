.home-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.home-topbar {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  padding: 4rpx 4rpx 0;
}

.home-hero {
  position: relative;
  padding: 4rpx 6rpx 4rpx;
  overflow: hidden;
}

.home-hero::after {
  content: "";
  position: absolute;
  right: -120rpx;
  top: 8rpx;
  width: 320rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(110deg, rgba(255, 209, 102, 0.20), rgba(251, 146, 60, 0.04));
  opacity: 0.9;
  transform: rotate(-12deg);
}

.home-brand-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.app-logo-mark {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  color: #f5c87a;
}

.logo-sun {
  position: absolute;
  left: 10rpx;
  top: 8rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: currentColor;
}

.logo-line {
  position: absolute;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.logo-line-1 {
  left: 2rpx;
  right: 2rpx;
  top: 32rpx;
}

.logo-line-2 {
  left: 12rpx;
  right: 12rpx;
  top: 39rpx;
  height: 3rpx;
}

.app-logo-text {
  color: #7a4a18;
  font-family: "Cormorant Garamond", Georgia, "Songti SC", "STSong", serif;
  font-size: 42rpx;
  font-weight: 300;
  letter-spacing: 0;
  line-height: 1;
}

.home-view-menu {
  position: relative;
  flex: none;
}

.home-header-actions {
  display: flex;
  flex: none;
  align-items: center;
  gap: 12rpx;
}

.menu-button {
  width: 56rpx;
  height: 44rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 36rpx;
  background: rgba(255, 255, 255, 0.06);
}

.home-view-menu-dropdown {
  position: absolute;
  top: 54rpx;
  right: 0;
  width: 244rpx;
  box-sizing: border-box;
  padding: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  background: rgba(10, 15, 30, 0.96);
  box-shadow: 0 18rpx 46rpx rgba(0, 0, 0, 0.34);
}

.home-title {
  position: relative;
  z-index: 1;
  max-width: 620rpx;
  margin-top: 22rpx;
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.14;
}

.home-subtitle {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 27rpx;
  line-height: 1.5;
}

.home-view-option {
  min-height: 56rpx;
  box-sizing: border-box;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 32rpx;
}

.home-view-option.active {
  color: #1b1206;
  font-weight: 800;
  background: linear-gradient(135deg, #ffd166, #fb923c);
}

.settings-panel {
  padding: 24rpx;
}

.settings-panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.settings-title {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
}

.settings-subtitle {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.48);
  font-size: 23rpx;
  line-height: 1.45;
}

.settings-close {
  width: 52rpx;
  height: 52rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 34rpx;
  line-height: 46rpx;
  background: rgba(255, 255, 255, 0.08);
}

.settings-group {
  margin-top: 22rpx;
}

.settings-label {
  color: #f5c87a;
  font-size: 24rpx;
  font-weight: 800;
}

.settings-segmented {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
  padding: 7rpx;
  border-radius: 14rpx;
  background: rgba(7, 16, 31, 0.52);
}

.settings-segment {
  flex: 1;
  height: 62rpx;
  border-radius: 10rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 62rpx;
  text-align: center;
}

.settings-segment.active {
  color: #1b1206;
  background: linear-gradient(135deg, #ffd166, #fb923c);
}

.home-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.control-card {
  padding: 26rpx;
}

.section-title {
  color: rgba(255, 255, 255, 0.66);
  font-size: 26rpx;
  font-weight: 700;
}

.date-title {
  margin-top: 26rpx;
}

.segmented {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: rgba(7, 16, 31, 0.58);
}

.segment {
  flex: 1;
  height: 74rpx;
  border-radius: 12rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 74rpx;
  text-align: center;
}

.segment.active {
  color: #1b1206;
  background: linear-gradient(135deg, #ffd166, #fb923c);
}

.query-button {
  width: 100%;
  margin: 0;
}

.error-card {
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(248, 113, 113, 0.28);
  border-radius: 14rpx;
  color: #fecaca;
  background: rgba(127, 29, 29, 0.26);
  font-size: 26rpx;
}

.home-search-loading {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx 30rpx;
  border-color: rgba(127, 83, 29, 0.14);
  border-radius: 20rpx;
  color: #3d3028;
  background: rgba(255, 252, 246, 0.92);
  box-shadow: 0 18rpx 48rpx rgba(92, 58, 20, 0.12), inset 0 1rpx 0 rgba(255, 255, 255, 0.90);
}

.home-search-spinner {
  flex: none;
  width: 54rpx;
  height: 54rpx;
  box-sizing: border-box;
  border: 6rpx solid rgba(127, 83, 29, 0.14);
  border-top-color: #f59e0b;
  border-radius: 50%;
  animation: xiake-spin 1s linear infinite;
}

.home-search-loading-copy {
  flex: 1;
  min-width: 0;
}

.home-search-loading-title {
  color: #3d3028;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.home-search-loading-progress {
  width: 100%;
  height: 12rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(127, 83, 29, 0.12);
}

.home-search-loading-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #ffd166, #fb923c, #fd79a8);
  transition: width 420ms ease;
  animation: xiake-loading-progress 1.6s ease-in-out infinite alternate;
}

.home-search-loading-detail {
  min-height: 32rpx;
  margin-top: 10rpx;
  color: #8a7666;
  font-size: 23rpx;
  line-height: 1.35;
}

@keyframes xiake-spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes xiake-loading-progress {
  from {
    opacity: 0.72;
    filter: brightness(0.96);
  }
  to {
    opacity: 1;
    filter: brightness(1.08);
  }
}

.home-weather-preview,
.home-prediction-preview {
  padding: 24rpx;
}

.home-weather-preview {
  overflow: hidden;
}

.preview-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.weather-panel-head {
  align-items: center;
}

.prediction-panel-head {
  align-items: center;
}

.preview-copy {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.46);
  font-size: 24rpx;
  line-height: 1.45;
}

.preview-badge,
.preview-score {
  flex: 0 0 auto;
  min-width: 92rpx;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #1b1206;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 52rpx;
  text-align: center;
  background: linear-gradient(135deg, #ffd166, #fb923c);
}

.preview-score {
  min-width: 58rpx;
  color: #f5c87a;
  background: rgba(245, 200, 122, 0.12);
}

.home-prediction-preview {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.prediction-app-nav {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  z-index: 2;
}

.prediction-preview-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.prediction-share-menu {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  color: #1b1206;
  font-size: 28rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #ffd166, #fb923c);
}

.prediction-preview-action-label {
  padding-right: 78rpx;
  color: rgba(255, 255, 255, 0.52);
  font-size: 23rpx;
  font-weight: 800;
}

.prediction-toggle-bar {
  display: flex;
  gap: 8rpx;
  width: 332rpx;
  box-sizing: border-box;
  margin: 20rpx auto 18rpx;
  padding: 8rpx;
  border: 2rpx solid rgba(127, 83, 29, 0.12);
  border-radius: 999rpx;
  background: rgba(255, 252, 246, 0.72);
  overflow: hidden;
}

.prediction-toggle {
  flex: 1;
  min-width: 0;
  min-height: 58rpx;
  box-sizing: border-box;
  padding: 0 26rpx;
  border-radius: 999rpx;
  color: rgba(89, 67, 54, 0.62);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 58rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.prediction-toggle.active {
  color: #ffffff;
  background: linear-gradient(135deg, #f59e0b, #ea8500);
}

.phenomenon-title-card {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 86rpx;
  padding: 10rpx 0 12rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.phenomenon-title-copy {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  text-align: center;
}

.phenomenon-date-tag {
  margin-bottom: 4rpx;
  color: rgba(89, 67, 54, 0.58);
  font-size: 20rpx;
  font-weight: 800;
}

.conclusion-banner {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.45;
  background: rgba(57, 168, 73, 0.14);
}

.conclusion-icon {
  flex: none;
  color: #86efac;
}

.score-summary-card {
  display: grid;
  grid-template-columns: 0.9fr 1rpx 1.1fr;
  gap: 18rpx;
  align-items: stretch;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  background: rgba(7, 16, 31, 0.42);
}

.score-summary-left,
.score-summary-right {
  min-width: 0;
}

.score-gauge-large-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  text-align: center;
}

.score-gauge-large {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 144rpx;
  border: 12rpx solid rgba(245, 200, 122, 0.22);
  border-radius: 50%;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.06);
}

.score-gauge-number {
  color: #f5c87a;
  font-size: 44rpx;
  font-weight: 900;
}

.score-gauge-total {
  color: rgba(255, 255, 255, 0.48);
  font-size: 21rpx;
  font-weight: 800;
}

.score-gauge-grade {
  color: #f5c87a;
  font-size: 24rpx;
  font-weight: 900;
}

.score-gauge-desc {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.52);
  font-size: 22rpx;
  line-height: 1.35;
}

.score-summary-divider {
  width: 1rpx;
  background: rgba(255, 255, 255, 0.10);
}

.event-time-label {
  color: rgba(255, 255, 255, 0.50);
  font-size: 22rpx;
  font-weight: 800;
}

.main-time {
  margin: 8rpx 0 16rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
}

.app-main-time {
  text-align: center;
}

.app-info-row {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  padding: 10rpx 0;
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
}

.app-info-value {
  color: rgba(255, 255, 255, 0.88);
  font-weight: 800;
  text-align: right;
}

.cloud-condition-card {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: rgba(7, 16, 31, 0.42);
}

.cloud-condition-item {
  min-width: 0;
}

.cloud-condition-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  color: rgba(255, 255, 255, 0.70);
  font-size: 23rpx;
  font-weight: 800;
}

.cloud-condition-value {
  color: #ffffff;
}

.cloud-condition-track {
  height: 8rpx;
  margin-top: 8rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.10);
}

.cloud-condition-fill {
  height: 100%;
  border-radius: inherit;
  background: #f5c87a;
}

.cloud-condition-fill-mid {
  background: #fb923c;
}

.cloud-condition-fill-low {
  background: #94a3b8;
}

.app-analysis-card {
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: rgba(7, 16, 31, 0.42);
}

.analysis-card-title {
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 900;
}

.analysis-factor-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
  margin-top: 14rpx;
}

.analysis-factor {
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.06);
}

.analysis-factor-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.analysis-factor-title {
  color: rgba(255, 255, 255, 0.86);
  font-size: 24rpx;
  font-weight: 900;
}

.analysis-factor-status {
  color: #f5c87a;
  font-size: 22rpx;
  font-weight: 900;
}

.analysis-factor-status-good {
  color: #86efac;
}

.analysis-factor-desc {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.52);
  font-size: 22rpx;
  line-height: 1.45;
}

.prediction-preview-action-primary {
  width: 100%;
  height: 72rpx;
  margin: 0;
  border-radius: 16rpx;
  color: #1b1206;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 72rpx;
  background: linear-gradient(135deg, #ffd166, #fb923c);
}

.weather-main-layout {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 22rpx;
}

.weather-visual-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  min-height: 360rpx;
  box-sizing: border-box;
  padding: 24rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 18rpx;
  text-align: center;
  background: linear-gradient(180deg, rgba(19, 32, 58, 0.76), rgba(8, 16, 31, 0.54));
}

.weather-location-inline,
.weather-wind-main {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  font-weight: 700;
}

.weather-location-pin,
.weather-wind-glyph {
  color: #f5c87a;
  font-size: 25rpx;
}

.weather-icon-large {
  color: #f8d083;
  font-size: 92rpx;
  line-height: 1;
}

.weather-desc {
  color: rgba(255, 255, 255, 0.72);
  font-size: 27rpx;
  font-weight: 800;
}

.weather-temp-large {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  color: rgba(255, 255, 255, 0.94);
  font-size: 86rpx;
  font-weight: 900;
  line-height: 1;
}

.temp-unit {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 28rpx;
  font-weight: 800;
}

.weather-wind-divider {
  width: 1rpx;
  height: 24rpx;
  background: rgba(255, 255, 255, 0.20);
}

.weather-metric-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 20rpx;
}

.weather-metric {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-height: 92rpx;
  box-sizing: border-box;
  padding: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: rgba(7, 16, 31, 0.42);
}

.weather-metric-icon {
  color: #f5c87a;
  font-size: 26rpx;
  line-height: 1;
}

.metric-label {
  color: rgba(255, 255, 255, 0.52);
  font-size: 22rpx;
}

.metric-value {
  color: rgba(255, 255, 255, 0.88);
  font-size: 25rpx;
  font-weight: 800;
}

.weather-view-toggle {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
}

.settings-done {
  width: 100%;
  height: 72rpx;
  margin: 24rpx 0 0;
  padding: 0;
  border-radius: 16rpx;
  color: #1b1206;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 72rpx;
  background: linear-gradient(135deg, #ffd166, #fb923c);
}

.weather-toggle {
  min-height: 56rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 56rpx;
  text-align: center;
}

.weather-toggle.active {
  color: #1b1206;
  background: linear-gradient(135deg, #ffd166, #fb923c);
}

.home-three-day-glow {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  color: rgba(255, 255, 255, 0.70);
  font-size: 24rpx;
  line-height: 1.45;
  background: rgba(251, 146, 60, 0.10);
}

.home-experience-strip {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12rpx;
}

.experience-chip {
  height: 68rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 68rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.06);
}

.placeholder-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.section-hint {
  max-width: 360rpx;
  color: rgba(255, 255, 255, 0.42);
  font-size: 22rpx;
  line-height: 1.45;
  text-align: right;
}

.mini-card {
  min-height: 210rpx;
  padding: 22rpx;
}

.mini-head {
  color: #f5c87a;
  font-size: 28rpx;
  font-weight: 800;
}

.query-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 18rpx;
  color: #ffffff;
  font-size: 25rpx;
}

.empty {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.44);
  font-size: 25rpx;
  line-height: 1.5;
}

/* Web mobile parity pass: home uses the same warm light shell as the H5 first viewport. */
.home-page {
  min-height: 100vh;
  padding: 32rpx 32rpx 64rpx;
  gap: 28rpx;
  color: #3d3028;
  background: #f6efe6;
}

.home-page .xiake-card,
.home-page .glass-card {
  border: 2rpx solid rgba(127, 83, 29, 0.15);
