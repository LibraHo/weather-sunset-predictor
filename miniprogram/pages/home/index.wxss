.home-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.home-hero {
  position: relative;
  padding: 18rpx 6rpx 4rpx;
  overflow: hidden;
}

.home-hero::after {
  content: "";
  position: absolute;
  right: -120rpx;
  top: 8rpx;
  width: 320rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(110deg, rgba(255, 209, 102, 0.20), rgba(251, 146, 60, 0.04));
  opacity: 0.9;
  transform: rotate(-12deg);
}

.home-brand-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.app-logo-mark {
  position: relative;
  width: 54rpx;
  height: 54rpx;
  color: #f5c87a;
}

.logo-arc {
  position: absolute;
  left: 9rpx;
  top: 8rpx;
  width: 36rpx;
  height: 30rpx;
  border-top: 4rpx solid currentColor;
  border-left: 4rpx solid currentColor;
  border-right: 4rpx solid currentColor;
  border-radius: 40rpx 40rpx 0 0;
}

.logo-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.logo-line-1 {
  top: 33rpx;
}

.logo-line-2 {
  left: 8rpx;
  right: 8rpx;
  top: 42rpx;
  height: 3rpx;
}

.logo-line-3 {
  left: 16rpx;
  right: 16rpx;
  top: 50rpx;
  height: 3rpx;
}

.app-logo-text {
  color: #f5c87a;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 0;
  line-height: 1;
}

.home-title {
  position: relative;
  z-index: 1;
  max-width: 620rpx;
  margin-top: 30rpx;
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.14;
}

.home-subtitle {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 27rpx;
  line-height: 1.5;
}

.home-view-rail {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 12rpx;
  margin-top: 28rpx;
  overflow-x: auto;
}

.home-view-option {
  flex: 0 0 auto;
  min-width: 92rpx;
  height: 58rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.70);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 58rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.06);
}

.home-view-option.active {
  color: #1b1206;
  font-weight: 800;
  background: linear-gradient(135deg, #ffd166, #fb923c);
}

.home-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.control-card {
  padding: 26rpx;
}

.section-title {
  color: rgba(255, 255, 255, 0.66);
  font-size: 26rpx;
  font-weight: 700;
}

.date-title {
  margin-top: 26rpx;
}

.segmented {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: rgba(7, 16, 31, 0.58);
}

.segment {
  flex: 1;
  height: 74rpx;
  border-radius: 12rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 74rpx;
  text-align: center;
}

.segment.active {
  color: #1b1206;
  background: linear-gradient(135deg, #ffd166, #fb923c);
}

.query-button {
  width: 100%;
  margin: 0;
}

.error-card {
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(248, 113, 113, 0.28);
  border-radius: 14rpx;
  color: #fecaca;
  background: rgba(127, 29, 29, 0.26);
  font-size: 26rpx;
}

.placeholder-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.section-hint {
  max-width: 360rpx;
  color: rgba(255, 255, 255, 0.42);
  font-size: 22rpx;
  line-height: 1.45;
  text-align: right;
}

.mini-card {
  min-height: 210rpx;
  padding: 22rpx;
}

.mini-head {
  color: #f5c87a;
  font-size: 28rpx;
  font-weight: 800;
}

.query-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 18rpx;
  color: #ffffff;
  font-size: 25rpx;
}

.empty {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.44);
  font-size: 25rpx;
  line-height: 1.5;
}
