<view class="container home-page theme-{{resolvedThemeMode}} {{weatherPreview.visible ? 'has-weather' : ''}}">
  <app-topbar current="home" period="{{period}}" theme-mode="{{themeMode}}" resolved-theme-mode="{{resolvedThemeMode}}" bind:settingschange="onAppSettingsChange" />
  <view class="home-topbar" wx:if="{{false}}">
    <view class="home-brand-row">
      <image class="app-logo-image" src="/assets/icons/xiake-logo.svg" mode="aspectFit" aria-hidden="true" />
      <view class="app-logo-text">霞客</view>
    </view>

    <view class="home-header-actions">
      <view class="home-view-menu">
        <button class="menu-button icon-button" aria-label="menu" bindtap="toggleHomeMenu">
          <image class="header-action-image" src="/assets/icons/menu.svg" mode="aspectFit" aria-hidden="true" />
        </button>
        <view class="home-view-menu-dropdown" wx:if="{{homeMenuOpen}}">
          <view class="home-view-option active" data-target="forecast" bindtap="navigateFeature">预测功能</view>
          <view class="home-view-option" data-target="settings" bindtap="navigateFeature">设置</view>
          <view class="home-view-option" data-target="methodology" bindtap="navigateFeature">火烧云计算方法</view>
          <view class="home-view-option" data-target="map" bindtap="navigateFeature">火烧云地图</view>
          <view class="home-view-option" data-target="gallery" bindtap="navigateFeature">分享地图</view>
        </view>
      </view>
      <button class="header-icon-button icon-button" aria-label="notice">
        <image class="header-action-image" src="/assets/icons/bell.svg" mode="aspectFit" aria-hidden="true" />
      </button>
      <button class="header-icon-button icon-button" aria-label="settings" bindtap="toggleSettings">
        <image class="header-action-image" src="/assets/icons/settings.svg" mode="aspectFit" aria-hidden="true" />
      </button>
    </view>
  </view>

  <view class="home-hero">
    <view class="home-title">先看火烧云条件，再安排观赏。</view>
    <view class="home-subtitle">和网站同源的评分、地图、分析与照片入口。</view>
  </view>

  <view class="settings-panel xiake-card" wx:if="{{false}}">
    <view class="settings-panel-head">
      <view>
        <view class="settings-title">设置</view>
        <view class="settings-subtitle">调整界面语言和显示主题。</view>
      </view>
      <button class="settings-close" bindtap="closeSettings">x</button>
    </view>
    <view class="settings-group">
      <view class="settings-label">界面语言</view>
      <view class="settings-segmented">
        <view class="settings-segment {{interfaceLanguage === 'zh-CN' ? 'active' : ''}}" data-value="zh-CN" bindtap="selectInterfaceLanguage">中文</view>
        <view class="settings-segment {{interfaceLanguage === 'en-US' ? 'active' : ''}}" data-value="en-US" bindtap="selectInterfaceLanguage">English</view>
      </view>
    </view>
    <view class="settings-group">
      <view class="settings-label">显示主题</view>
      <view class="settings-segmented">
        <view class="settings-segment {{themeMode === 'system' ? 'active' : ''}}" data-value="system" bindtap="selectThemeMode">跟随系统</view>
        <view class="settings-segment {{themeMode === 'light' ? 'active' : ''}}" data-value="light" bindtap="selectThemeMode">浅色</view>
        <view class="settings-segment {{themeMode === 'dark' ? 'active' : ''}}" data-value="dark" bindtap="selectThemeMode">深色</view>
      </view>
    </view>
    <button class="settings-done" bindtap="closeSettings">完成</button>
  </view>

  <view class="weather-unavailable-card xiake-card" wx:if="{{siteState.weatherPredictionClosed}}">
    <view class="weather-unavailable-title">天气预测暂时不可用</view>
    <view class="weather-unavailable-body">请稍后再来。</view>
    <view class="weather-unavailable-actions">
      <view class="weather-unavailable-action primary tap-feedback" hover-class="tap-feedback-hover" hover-stay-time="80" data-target="gallery" bindtap="navigateFeature">分享地图</view>
      <view class="weather-unavailable-action tap-feedback" hover-class="tap-feedback-hover" hover-stay-time="80" data-target="map" bindtap="navigateFeature">火烧云地图</view>
    </view>
  </view>

  <block wx:if="{{!siteState.weatherPredictionClosed}}">
  <location-search value="{{locationText}}" locating="{{locating}}" favoriteLoading="{{favoriteLoading}}" loading="{{loading}}" theme="{{resolvedThemeMode}}" candidates="{{locationCandidates}}" bind:change="onLocationChange" bind:confirm="onSearch" bind:locate="onUseCurrentLocation" bind:favorite="onAddCurrentFavorite" bind:selectcandidate="selectLocationCandidate" />

  <view class="home-search-loading xiake-card" wx:if="{{loading}}" role="status" aria-live="polite">
    <view class="home-search-spinner" aria-hidden="true"></view>
    <view class="home-search-loading-copy">
      <view class="home-search-loading-title">{{loadingMessage}}</view>
      <view class="home-search-loading-progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{loadingProgress}}">
        <view class="home-search-loading-fill" style="width: {{loadingProgress}}%;"></view>
      </view>
      <view class="home-search-loading-detail">{{loadingDetail}}</view>
    </view>
  </view>

  <view class="home-web-spacer"></view>

  <view class="home-footer-card xiake-card" wx:if="{{!weatherPreview.visible}}">
    <button class="footer-refresh-button">刷新</button>
    <view class="footer-source">数据来源：Open-Meteo（GFS + ECMWF）</view>
    <view class="footer-visitor">
      <image class="footer-visitor-icon" src="/assets/icons/users.svg" mode="aspectFit" aria-hidden="true" />
      <text>访问人数：</text>
      <text class="footer-visitor-number">{{visitorCountText}}</text>
    </view>
  </view>

  <view class="control-card xiake-card">
    <view class="section-title">预测类型</view>
    <view class="segmented">
      <view class="segment tap-feedback {{period === 'sunrise' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-value="sunrise" bindtap="selectPeriod">朝霞</view>
      <view class="segment tap-feedback {{period === 'sunset' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-value="sunset" bindtap="selectPeriod">晚霞</view>
    </view>

    <view class="section-title date-title">日期</view>
    <view class="segmented">
      <view class="segment tap-feedback {{day === 'today' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-value="today" bindtap="selectDay">今天</view>
      <view class="segment tap-feedback {{day === 'tomorrow' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-value="tomorrow" bindtap="selectDay">明天</view>
    </view>
  </view>

  <view class="error-card" wx:if="{{errorMessage}}">{{errorMessage}}</view>

  <button class="primary-button query-button" loading="{{loading}}" disabled="{{loading}}" hover-class="button-hover" hover-stay-time="80" bindtap="onSearch">
    {{loading ? '查询中...' : '查询霞光分数'}}
  </button>
  </block>

  <view class="home-weather-preview xiake-card" wx:if="{{weatherPreview.visible && !siteState.weatherPredictionClosed}}">
    <view class="preview-head weather-panel-head">
      <view>
        <view class="section-title weather-panel-title">{{weatherPreview.title}}</view>
      </view>
    </view>

    <view class="weather-main-layout">
      <view class="weather-visual-panel">
        <view class="weather-location-inline">
          <image class="weather-location-pin" src="/assets/icons/weather-location-pin.svg" mode="aspectFit" aria-hidden="true" />
          <text>{{weatherPreview.location}}</text>
        </view>
        <image class="weather-icon-image" src="{{weatherPreview.iconSrc}}" mode="aspectFit" aria-hidden="true" />
        <view class="weather-desc">{{weatherPreview.condition}}</view>
        <view class="weather-temp-large">
          <text>{{weatherPreview.temperature}}</text>
          <text class="temp-unit">{{weatherPreview.temperatureUnit}}</text>
        </view>
        <view class="weather-wind-main">
          <image class="weather-wind-glyph" src="/assets/icons/metric-wind.svg" mode="aspectFit" aria-hidden="true" />
          <text class="weather-wind-speed">{{weatherPreview.windSpeed}}</text>
          <text class="weather-wind-divider"></text>
          <text class="weather-wind-direction-text">{{weatherPreview.windDirection}}</text>
          <text class="weather-wind-direction-arrow">{{weatherPreview.windDirectionArrow}}</text>
        </view>
      </view>

      <view class="weather-metric-grid">
        <view class="weather-metric weather-metric-{{item.key}}" wx:for="{{weatherPreview.metrics}}" wx:key="key">
          <image class="weather-metric-image" src="/assets/icons/metric-{{item.key}}.svg" mode="aspectFit" aria-hidden="true" />
          <text class="metric-label">{{item.label}}</text>
          <text class="metric-value">{{item.value}}</text>
          <text class="metric-hint" wx:if="{{item.hint}}">{{item.hint}}</text>
        </view>
      </view>
    </view>

    <view class="weather-forecast-module">
      <view class="weather-view-toggle">
        <view class="weather-toggle tap-feedback {{weatherView === 'overview' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-view="overview" bindtap="switchWeatherView">{{weatherPreview.weeklyTab}}</view>
        <view class="weather-toggle tap-feedback {{weatherView === 'hourly' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-view="hourly" bindtap="switchWeatherView">{{weatherPreview.hourlyTab}}</view>
        <view class="weather-toggle tap-feedback {{weatherView === 'glow' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-view="glow" bindtap="switchWeatherView">{{weatherPreview.glowTab}}</view>
      </view>
      <view class="weather-weekly-list" wx:if="{{weatherView === 'overview' && weatherPreview.weekly.length}}">
      <view class="weather-weekly-row" wx:for="{{weatherPreview.weekly}}" wx:key="key">
        <view class="weather-weekly-day">
          <text class="weather-weekly-label">{{item.label}}</text>
          <text class="weather-weekly-date">{{item.dayDate}}</text>
        </view>
        <image class="weather-weekly-icon" src="{{item.iconSrc}}" mode="aspectFit" aria-hidden="true" />
        <view class="weather-weekly-temp">
          <text class="weather-weekly-min">{{item.minTemp}}</text>
          <text class="weather-weekly-sep">~</text>
          <text class="weather-weekly-max">{{item.maxTemp}}</text>
        </view>
        <view class="weather-weekly-values">
          <view class="weather-weekly-meta weather-weekly-precip">
            <image class="weather-weekly-meta-icon" src="/assets/icons/metric-precipitation.svg" mode="aspectFit" aria-hidden="true" />
            <text class="weather-weekly-precip-text">{{item.precip}}</text>
          </view>
          <view class="weather-weekly-meta weather-weekly-wind">
            <image class="weather-weekly-meta-icon" src="/assets/icons/metric-wind.svg" mode="aspectFit" aria-hidden="true" />
            <text class="weather-weekly-wind-text">{{item.wind}}</text>
            <text class="weather-weekly-wind-arrow">{{item.windArrow}}</text>
          </view>
        </view>
      </view>
    </view>
      <view class="weather-hourly-panel" wx:if="{{weatherView === 'hourly' && weatherPreview.hourly.length}}">
      <view class="weather-day-selector xiake-toggle xiake-toggle-compact">
        <view class="weather-day-option tap-feedback {{weatherDay === item.key ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" wx:for="{{weatherPreview.hourlyView.dayOptions}}" wx:key="key" data-day="{{item.key}}" bindtap="switchWeatherDay">{{item.label}}</view>
      </view>
      <view class="weather-parameter-selector xiake-toggle xiake-toggle-wrap">
        <view class="weather-param-option tap-feedback {{weatherParameter === 'temp' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-param="temp" bindtap="switchWeatherParameter"><image class="weather-param-icon" src="/assets/icons/weather-param-temperature.svg" mode="aspectFit" aria-hidden="true" /><text class="weather-param-label">温度</text></view>
        <view class="weather-param-option tap-feedback {{weatherParameter === 'precip' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-param="precip" bindtap="switchWeatherParameter"><image class="weather-param-icon" src="/assets/icons/weather-param-precipitation.svg" mode="aspectFit" aria-hidden="true" /><text class="weather-param-label">降水</text></view>
        <view class="weather-param-option tap-feedback {{weatherParameter === 'humidity' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-param="humidity" bindtap="switchWeatherParameter"><image class="weather-param-icon" src="/assets/icons/weather-param-humidity.svg" mode="aspectFit" aria-hidden="true" /><text class="weather-param-label">湿度</text></view>
        <view class="weather-param-option tap-feedback {{weatherParameter === 'wind' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-param="wind" bindtap="switchWeatherParameter"><image class="weather-param-icon" src="/assets/icons/weather-param-wind.svg" mode="aspectFit" aria-hidden="true" /><text class="weather-param-label">风速</text></view>
        <view class="weather-param-option tap-feedback {{weatherParameter === 'pressure' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-param="pressure" bindtap="switchWeatherParameter"><image class="weather-param-icon" src="/assets/icons/weather-param-pressure.svg" mode="aspectFit" aria-hidden="true" /><text class="weather-param-label">气压</text></view>
        <view class="weather-param-option tap-feedback {{weatherParameter === 'clouds' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-param="clouds" bindtap="switchWeatherParameter"><image class="weather-param-icon" src="/assets/icons/weather-param-cloud.svg" mode="aspectFit" aria-hidden="true" /><text class="weather-param-label">云量</text></view>
      </view>
      <view class="weather-chart-panel">
        <view class="weather-chart-title">{{weatherPreview.hourlyView.label}}趋势 ({{weatherPreview.hourlyView.unit}})</view>
      <view class="weather-hourly-chart" aria-label="24小时预报图">
        <view class="weather-hourly-axis">
          <text class="weather-hourly-axis-label" wx:for="{{weatherPreview.hourlyView.axisLabels}}" wx:key="key">{{item.value}}</text>
        </view>
        <view class="weather-hourly-grid-line weather-hourly-grid-line-top"></view>
        <view class="weather-hourly-grid-line weather-hourly-grid-line-mid"></view>
        <view class="weather-hourly-grid-line weather-hourly-grid-line-bottom"></view>
        <canvas id="homeHourlyChart" canvas-id="homeHourlyChart" type="2d" class="weather-hourly-canvas" disable-scroll="true"></canvas>
          <view class="weather-hourly-chart-point" wx:for="{{weatherPreview.hourlyChart}}" wx:key="key" style="left: {{item.left}}%; top: {{item.top}}%;">
            <text class="weather-hourly-point-label weather-hourly-point-label-{{item.labelPlacement}}" wx:if="{{item.labelVisible}}">{{item.valueText}}</text>
            <view class="weather-hourly-chart-dot"></view>
          </view>
        <view class="weather-hourly-time-axis">
          <text class="weather-hourly-time-label weather-hourly-time-label-{{item.placement}}" wx:for="{{weatherPreview.hourlyView.xAxisLabels}}" wx:key="key" style="left: {{item.left}}%;">{{item.value}}</text>
        </view>
      </view>
      </view>
    </view>
      <view class="weather-glow-panel" wx:if="{{weatherView === 'glow' && weatherPreview.glow.length}}">
      <view class="weather-glow-card" wx:for="{{weatherPreview.glow}}" wx:key="key">
        <view class="weather-glow-head">
          <view class="weather-glow-day">{{item.label}}</view>
          <view class="weather-glow-date">{{item.dayDate}}</view>
        </view>
        <view class="weather-glow-score-row">
          <image class="weather-glow-score-icon" src="/assets/icons/sun-event-sunrise.svg" mode="aspectFit" aria-hidden="true" />
          <view class="weather-glow-score weather-glow-score-sunrise"><text class="weather-glow-score-label">朝</text><text>{{item.sunrise}}</text></view>
          <image class="weather-glow-score-icon" src="/assets/icons/sun-event-sunset.svg" mode="aspectFit" aria-hidden="true" />
          <view class="weather-glow-score weather-glow-score-sunset"><text class="weather-glow-score-label">晚</text><text>{{item.sunset}}</text></view>
        </view>
      </view>
      </view>
    </view>
  </view>

  <view class="home-prediction-preview xiake-card" wx:if="{{weatherPreview.visible && !siteState.weatherPredictionClosed}}">
    <view class="preview-head prediction-panel-head">
      <view>
        <view class="section-title prediction-panel-title">朝晚霞预测</view>
      </view>
    </view>
    <view class="prediction-toggle-bar">
      <view class="prediction-toggle tap-feedback {{predictionPreview.periodKey === 'sunrise' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-value="sunrise" bindtap="selectPredictionPreviewPeriod">朝霞</view>
      <view class="prediction-toggle tap-feedback {{predictionPreview.periodKey === 'sunset' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-value="sunset" bindtap="selectPredictionPreviewPeriod">晚霞</view>
    </view>

    <view class="prediction-local-loading" wx:if="{{predictionPreviewLoading}}">
      <view class="prediction-local-loading-copy">基础天气已加载，正在计算朝晚霞评分</view>
      <view class="prediction-local-loading-track"><view class="prediction-local-loading-fill"></view></view>
    </view>

    <view class="prediction-hero-card">
    <view class="phenomenon-title-card">
      <view class="phenomenon-title-copy">
        <view class="phenomenon-date-tag">{{predictionPreview.dateLabel}}</view>
        <view class="section-title">{{predictionPreview.periodLabel}}</view>
      </view>
    </view>

    <view class="conclusion-banner">
      <image class="leaf-icon-image" src="/assets/icons/leaf.svg" mode="aspectFit" aria-hidden="true" />
      <text class="conclusion-copy">{{predictionPreview.conclusion}}</text>
    </view>

    <view class="score-summary-card">
      <view class="score-summary-left">
        <view class="score-gauge-large-wrap">
          <view class="score-gauge-large">
            <view class="score-gauge-center">
              <text class="score-gauge-number">{{predictionPreview.score}}</text>
              <text class="score-gauge-total">/100</text>
            </view>
          </view>
          <view class="score-gauge-caption">
            <view class="score-gauge-grade">{{predictionPreview.scoreLabel}}</view>
            <view class="score-gauge-desc">{{predictionPreview.scoreDesc}}</view>
          </view>
        </view>
      </view>
      <view class="score-summary-divider"></view>
      <view class="score-summary-right">
        <view class="event-time-label">{{predictionPreview.eventTimeLabel}}</view>
        <view class="main-time app-main-time">{{predictionPreview.mainTime}}</view>
        <view class="app-info-row">
          <text class="app-info-label">最佳观赏</text>
          <text class="app-info-value">{{predictionPreview.bestViewingTime}}</text>
        </view>
        <view class="app-info-row">
          <text class="app-info-label">{{predictionPreview.directionLabel}}</text>
          <text class="app-info-value">{{predictionPreview.direction}}</text>
        </view>
        <button class="score-detail-trigger tap-feedback" hover-class="tap-feedback-hover" hover-stay-time="80" bindtap="toggleScoreLedger">
          <text>{{scoreLedgerOpen ? '收起评分细则' : '查看评分细则'}}</text>
        </button>
      </view>
    </view>
    <view class="home-score-ledger-panel" wx:if="{{scoreLedgerOpen}}">
      <view class="home-score-ledger-head">
        <view>
          <view class="home-score-ledger-title">评分细则</view>
          <view class="home-score-ledger-subtitle">分层载体 × 分层受光亮度，再乘空气显色</view>
        </view>
        <button class="home-score-ledger-close" bindtap="closeScoreLedger" aria-label="关闭评分细则">×</button>
      </view>
      <view class="home-score-ledger-summary">{{predictionPreview.scoreLedger.summary}}</view>
      <view class="home-score-ledger-flow">
        <view class="home-score-ledger-step home-score-ledger-step-{{item.tone}}" wx:for="{{predictionPreview.scoreLedger.steps}}" wx:key="key">
          <text class="home-score-ledger-index">{{index + 1}}</text>
          <view class="home-score-ledger-body">
            <view class="home-score-ledger-line">
              <text class="home-score-ledger-label">{{item.label}}</text>
              <text class="home-score-ledger-result">{{item.result}}</text>
            </view>
            <view class="home-score-ledger-expression" wx:if="{{item.expression}}">{{item.expression}}</view>
            <view class="home-score-ledger-detail" wx:if="{{item.detail}}">{{item.detail}}</view>
          </view>
        </view>
      </view>
    </view>
    </view>

    <view class="cloud-condition-card">
      <view class="cloud-condition-item" wx:for="{{predictionPreview.clouds}}" wx:key="key">
        <view class="cloud-condition-top">
          <image class="cloud-layer-image" src="/assets/icons/cloud-layer.svg" mode="aspectFit" aria-hidden="true" />
          <text class="cloud-condition-label">{{item.label}}</text>
          <text class="cloud-condition-value">{{item.value}}%</text>
        </view>
        <view class="cloud-condition-track">
          <view class="cloud-condition-fill cloud-condition-fill-{{item.key}}" style="width: {{item.value}}%;"></view>
        </view>
      </view>
    </view>

    <view class="analysis-card app-analysis-card">
      <view class="analysis-card-head">
        <view class="analysis-card-title">火烧云文字分析</view>
        <view class="analysis-card-subtitle">云层、光路、空气和限制项</view>
      </view>
      <view class="analysis-factor-grid">
        <view class="analysis-factor analysis-factor-{{item.tone}}" wx:for="{{predictionPreview.analysis}}" wx:key="key">
          <view class="analysis-factor-heading">
            <view class="analysis-factor-title-wrap">
              <text class="analysis-factor-icon-dot"></text>
              <text class="analysis-factor-title">{{item.title}}</text>
            </view>
            <text class="analysis-factor-tag">{{item.status}}</text>
          </view>
          <view class="analysis-factor-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <view class="prediction-radar-card">
      <view class="prediction-radar-head">
        <view class="prediction-radar-title">周边云况雷达</view>
        <view class="prediction-radar-subtitle">25km · 连续云场</view>
        </view>
        <view class="prediction-radar-dial">
          <view class="prediction-radar-cloud-field">
            <canvas id="homeRadarCloudField" canvas-id="homeRadarCloudField" type="2d" class="prediction-radar-cloud-canvas" disable-scroll="true"></canvas>
          </view>
          <view class="prediction-radar-ring prediction-radar-ring-low-inner"></view>
          <view class="prediction-radar-ring prediction-radar-ring-low"></view>
        <view class="prediction-radar-ring prediction-radar-ring-mid"></view>
        <view class="prediction-radar-ring prediction-radar-ring-high"></view>
        <view class="prediction-radar-ring-label prediction-radar-ring-label-high">高云</view>
        <view class="prediction-radar-ring-label prediction-radar-ring-label-mid">中云</view>
        <view class="prediction-radar-ring-label prediction-radar-ring-label-low">低云</view>
        <view class="prediction-radar-axis prediction-radar-axis-ns"></view>
        <view class="prediction-radar-axis prediction-radar-axis-ew"></view>
        <view class="prediction-radar-axis prediction-radar-axis-ne"></view>
        <view class="prediction-radar-axis prediction-radar-axis-nw"></view>
        <view class="prediction-radar-center"></view>
        <view wx:if="{{predictionPreview.radar.sunMarker}}" class="prediction-radar-sun-marker" style="left: {{predictionPreview.radar.sunMarker.left}}%; top: {{predictionPreview.radar.sunMarker.top}}%;">
          <view class="prediction-radar-sun-dot"></view>
          <text class="prediction-radar-sun-label">{{predictionPreview.radar.sunMarker.shortLabel}}</text>
        </view>
        <view class="prediction-radar-direction prediction-radar-direction-{{item.direction}}" wx:for="{{predictionPreview.radar.directions}}" wx:key="direction">
          <text class="prediction-radar-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <view class="prediction-share-footer-row">
      <button class="prediction-share-menu prediction-share-footer" open-type="share" aria-label="分享霞光评分" hover-class="button-hover" hover-stay-time="80">
        <image class="share-icon-image" src="/assets/icons/share-upload.svg" mode="aspectFit" aria-hidden="true" />
        <text class="share-btn-label">分享</text>
      </button>
      <button class="prediction-share-menu prediction-share-footer prediction-feedback-footer" bindtap="openFeedback" aria-label="反馈预测结果" hover-class="button-hover" hover-stay-time="80">
        <image class="feedback-icon-image" src="/assets/icons/feedback-message.svg" mode="aspectFit" aria-hidden="true" />
        <text class="share-btn-label">反馈</text>
      </button>
    </view>

    <view wx:if="{{feedbackModalVisible}}" class="feedback-mask" bindtap="closeFeedback">
      <view class="feedback-sheet xiake-card" catchtap="noop">
        <view class="feedback-title">反馈预测结果</view>
        <view class="feedback-help">反馈只在日出/日落前 1 小时到事件后 45 分钟内开放。</view>
        <view class="feedback-type-row">
          <view class="feedback-type {{feedbackForm.feedbackType === 'missed' ? 'active' : ''}}" data-type="missed" bindtap="updateFeedbackType">漏报<text>实际很好但分低</text></view>
          <view class="feedback-type {{feedbackForm.feedbackType === 'wrong' ? 'active' : ''}}" data-type="wrong" bindtap="updateFeedbackType">误报<text>实际不好但分高</text></view>
          <view class="feedback-type {{feedbackForm.feedbackType === 'overstated' ? 'active' : ''}}" data-type="overstated" bindtap="updateFeedbackType">虚报<text>有颜色但不值冲</text></view>
        </view>
        <textarea class="feedback-input feedback-textarea" placeholder="评论：描述现场云量、颜色、遮挡和时间" data-field="comment" value="{{feedbackForm.comment}}" bindinput="updateFeedbackField" />
        <input class="feedback-input" placeholder="昵称" data-field="nickname" value="{{feedbackForm.nickname}}" bindinput="updateFeedbackField" />
        <input class="feedback-input" placeholder="邮箱" data-field="contactEmail" value="{{feedbackForm.contactEmail}}" bindinput="updateFeedbackField" />
        <view class="feedback-image-row">
          <view class="feedback-image" wx:for="{{feedbackImages}}" wx:key="path">
            <image src="{{item.path}}" mode="aspectFill" />
            <text data-index="{{index}}" bindtap="removeFeedbackImage">×</text>
          </view>
          <view wx:if="{{feedbackImages.length < 2}}" class="feedback-add-image" bindtap="chooseFeedbackImages">+ 图片</view>
        </view>
        <view class="feedback-actions">
          <button class="ghost-button action-button" bindtap="closeFeedback">取消</button>
          <button class="primary-button action-button" loading="{{feedbackSubmitting}}" bindtap="submitFeedbackForm">提交反馈</button>
        </view>
      </view>
    </view>

    <view class="prediction-app-footer">Observe the sky · Catch the beauty</view>

  </view>

  <view class="home-experience-strip" wx:if="{{weatherPreview.visible}}">
        <view class="experience-chip tap-feedback" hover-class="tap-feedback-hover" hover-stay-time="80" data-target="methodology" bindtap="navigateFeature">方法</view>
        <view class="experience-chip tap-feedback" hover-class="tap-feedback-hover" hover-stay-time="80" data-target="map" bindtap="navigateFeature">地图</view>
        <view class="experience-chip tap-feedback" hover-class="tap-feedback-hover" hover-stay-time="80" data-target="gallery" bindtap="navigateFeature">照片</view>
      </view>

  <view class="home-section-head" wx:if="{{weatherPreview.visible}}">
    <view class="section-title">最近地点</view>
    <view class="section-hint">常用地点会在这里出现。</view>
  </view>

  <view class="placeholder-grid" wx:if="{{weatherPreview.visible}}">
    <view class="mini-card xiake-card">
      <view class="mini-head">最近查询</view>
      <block wx:if="{{recentQueries.length}}">
        <view class="query-item tap-feedback" hover-class="card-tap-hover" hover-stay-time="80" wx:for="{{recentQueries}}" wx:key="savedAt" data-index="{{index}}" data-location="{{item.locationName}}" bindtap="useHistory">
          <text>{{item.locationName}}</text>
          <text class="subtle-text">{{item.periodLabel}} · {{item.dayLabel}}</text>
        </view>
      </block>
      <view class="empty" wx:else>查询后这里会保存最近地点。</view>
    </view>

    <view class="mini-card xiake-card">
      <view class="mini-head">收藏地点</view>
      <block wx:if="{{favorites.length}}">
        <view class="query-item tap-feedback" hover-class="card-tap-hover" hover-stay-time="80" wx:for="{{favorites}}" wx:key="name" data-location="{{item.name}}" data-lat="{{item.lat}}" data-lon="{{item.lon}}" bindtap="useHistory">
          <text>{{item.name}}</text>
          <text class="subtle-text">点击再次查询</text>
        </view>
      </block>
      <view class="empty" wx:else>收藏后的地点会放在这里。</view>
    </view>
  </view>
</view>
