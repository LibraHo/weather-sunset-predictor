.simulator-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 72rpx;
  background: linear-gradient(180deg, #07101f 0%, #0b1222 44%, #101827 100%);
}

.simulator-hero {
  padding: 34rpx 30rpx 12rpx;
}

.simulator-kicker {
  color: #f5c87a;
  font-size: 23rpx;
  font-weight: 900;
  text-transform: uppercase;
}

.simulator-title {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.16;
}

.simulator-copy {
  margin-top: 14rpx;
  max-width: 640rpx;
  color: rgba(226, 232, 240, 0.74);
  font-size: 26rpx;
  line-height: 1.58;
}

.simulator-radar-card,
.simulator-controls,
.simulator-cloud-editor,
.simulator-result-list {
  margin: 22rpx 24rpx 0;
  padding: 24rpx;
  background: rgba(15, 23, 42, 0.76);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
}

.simulator-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.simulator-card-head.compact {
  align-items: center;
}

.simulator-card-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.simulator-card-subtitle {
  margin-top: 8rpx;
  color: rgba(203, 213, 225, 0.68);
  font-size: 24rpx;
  line-height: 1.45;
}

.simulator-angle-pill,
.simulator-add-button {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  color: #fed7aa;
  font-size: 24rpx;
  font-weight: 900;
  background: rgba(249, 115, 22, 0.16);
  border: 1rpx solid rgba(251, 146, 60, 0.32);
}

.simulator-canvas-wrap {
  position: relative;
  overflow: hidden;
  margin-top: 20rpx;
  border-radius: 12rpx;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.92), rgba(2, 6, 23, 0.88));
  border: 1rpx solid rgba(148, 163, 184, 0.12);
}

.simulator-canvas {
  display: block;
  width: 100%;
  height: 520rpx;
}

.simulator-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 18rpx;
  padding: 16rpx 18rpx 18rpx;
  color: rgba(226, 232, 240, 0.74);
  font-size: 23rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

.legend-lit { background: #fb923c; }
.legend-dimmed { background: #a78bfa; }
.legend-shadowed { background: #64748b; }
.legend-dark { background: #111827; border: 1rpx solid #94a3b8; }

.simulator-control-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.control-block {
  min-width: 0;
}

.control-wide {
  grid-column: 1 / -1;
}

.control-label {
  margin-bottom: 12rpx;
  color: rgba(226, 232, 240, 0.78);
  font-size: 24rpx;
  font-weight: 800;
}

.simulator-segmented {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  padding: 6rpx;
  border-radius: 10rpx;
  background: rgba(2, 6, 23, 0.54);
  border: 1rpx solid rgba(148, 163, 184, 0.12);
}

.simulator-segment {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  color: rgba(226, 232, 240, 0.74);
  font-size: 25rpx;
  font-weight: 900;
}

.simulator-segment.active {
  color: #0f172a;
  background: linear-gradient(135deg, #fbbf24, #fb923c);
}

.cloud-picker-row {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  margin-top: 20rpx;
  padding-bottom: 4rpx;
}

.cloud-picker {
  flex: 0 0 220rpx;
  padding: 16rpx;
  border-radius: 10rpx;
  background: rgba(2, 6, 23, 0.46);
  border: 1rpx solid rgba(148, 163, 184, 0.14);
}

.cloud-picker.active {
  border-color: rgba(251, 146, 60, 0.58);
  background: rgba(249, 115, 22, 0.14);
}

.cloud-picker-name {
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
}

.cloud-picker-meta {
  margin-top: 8rpx;
  color: rgba(203, 213, 225, 0.68);
  font-size: 22rpx;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 20rpx;
}

.field-card {
  padding: 14rpx;
  border-radius: 10rpx;
  background: rgba(2, 6, 23, 0.38);
  border: 1rpx solid rgba(148, 163, 184, 0.12);
}

.field-card text {
  display: block;
  color: rgba(203, 213, 225, 0.72);
  font-size: 22rpx;
  font-weight: 800;
}

.field-card input {
  margin-top: 8rpx;
  min-height: 48rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
}

.simulator-result-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.simulator-cloud-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx;
  border-radius: 10rpx;
  background: rgba(2, 6, 23, 0.42);
  border: 1rpx solid rgba(148, 163, 184, 0.12);
}

.simulator-cloud-row-lit {
  border-color: rgba(251, 146, 60, 0.34);
}

.simulator-cloud-row-dimmed {
  border-color: rgba(167, 139, 250, 0.28);
}

.simulator-cloud-row-shadowed,
.simulator-cloud-row-unlit {
  opacity: 0.88;
}

.simulator-cloud-row.always-dark {
  background: rgba(2, 6, 23, 0.68);
}

.cloud-row-main {
  min-width: 0;
}

.cloud-row-name {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}

.cloud-row-reason {
  margin-top: 6rpx;
  color: rgba(203, 213, 225, 0.66);
  font-size: 23rpx;
  line-height: 1.42;
}

.cloud-row-status {
  flex: 0 0 132rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  color: #fed7aa;
  font-size: 24rpx;
  font-weight: 900;
}

.always-dark-tag {
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  color: #cbd5e1;
  background: rgba(15, 23, 42, 0.86);
  border: 1rpx solid rgba(148, 163, 184, 0.22);
  font-size: 20rpx;
}
