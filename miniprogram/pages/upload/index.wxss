.upload-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.upload-hero {
  padding: 12rpx 6rpx 4rpx;
}

.eyebrow {
  color: #f5c87a;
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.headline {
  margin-top: 16rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.18;
}

.caption {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 26rpx;
  line-height: 1.55;
}

.upload-parity-note {
  padding: 22rpx;
  background: rgba(18, 28, 52, 0.58);
}

.upload-parity-note .section-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.upload-parity-note .subtle-text {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
  line-height: 1.5;
}

.glass-card {
  background: rgba(18, 28, 52, 0.82);
}

.picker-card {
  min-height: 420rpx;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 420rpx;
  display: block;
}

.picker-empty {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: linear-gradient(135deg, rgba(245, 200, 122, 0.13), rgba(100, 168, 240, 0.11));
}

.picker-mark {
  width: 112rpx;
  height: 112rpx;
  border: 1rpx solid rgba(245, 200, 122, 0.36);
  border-radius: 999rpx;
  color: #f5c87a;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 112rpx;
  background: rgba(10, 15, 30, 0.46);
}

.picker-title {
  margin-top: 22rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
}

.picker-copy {
  margin-top: 10rpx;
  font-size: 25rpx;
}

.upload-format-hint,
.metadata-edit-hint {
  color: rgba(255, 255, 255, 0.60);
  font-size: 23rpx;
  line-height: 1.45;
}

.upload-format-hint {
  margin-top: 14rpx;
  padding: 0 32rpx;
}

.metadata-edit-hint {
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(245, 200, 122, 0.16);
  border-radius: 14rpx;
  background: rgba(251, 146, 60, 0.08);
}

.form-card {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 26rpx;
}

.field-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.field-label {
  color: rgba(255, 255, 255, 0.64);
  font-size: 25rpx;
  font-weight: 700;
}

.field-input,
.field-textarea {
  width: 100%;
  box-sizing: border-box;
  margin-top: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 14rpx;
  color: #ffffff;
  background: rgba(7, 16, 31, 0.58);
  font-size: 28rpx;
}

.field-input {
  height: 78rpx;
  padding: 0 20rpx;
}

.field-textarea {
  min-height: 150rpx;
  padding: 18rpx 20rpx;
  line-height: 1.45;
}

.upload-progress {
  padding: 22rpx;
}

.progress-head {
  display: flex;
  justify-content: space-between;
  color: #f5c87a;
  font-size: 26rpx;
  font-weight: 800;
}

.progress-track {
  height: 12rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.10);
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffd166, #fb923c);
}

.error-card,
.success-card {
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  line-height: 1.45;
}

.error-card {
  border: 1rpx solid rgba(248, 113, 113, 0.28);
  color: #fecaca;
  background: rgba(127, 29, 29, 0.26);
}

.success-card {
  border: 1rpx solid rgba(74, 222, 128, 0.22);
  color: #bbf7d0;
  background: rgba(22, 101, 52, 0.22);
}

.action-row {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
}

.submit-button,
.gallery-button {
  width: 100%;
  margin: 0;
}

.gallery-button {
  height: 88rpx;
  font-size: 30rpx;
  line-height: 88rpx;
}
