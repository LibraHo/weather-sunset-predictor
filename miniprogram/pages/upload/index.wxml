<view class="container upload-page">
  <app-topbar current="upload" />
  <view class="upload-hero">
    <view class="eyebrow warm-accent">霞客投稿</view>
    <view class="headline">把这次霞光放到地图上。</view>
    <view class="caption">选择照片，补充地点和拍摄时间，审核后展示在分享地图。</view>
  </view>

  <view class="upload-parity-note xiake-card">
    <view class="section-title">上传晚霞照片</view>
    <view class="subtle-text">从预测结果带入地点后，补充照片和拍摄时间。</view>
  </view>

  <view class="picker-card xiake-card glass-card tap-feedback" bindtap="choosePhoto" hover-class="card-tap-hover" hover-stay-time="80">
    <image wx:if="{{hasPhoto}}" class="preview-image" src="{{previewUrl}}" mode="aspectFill" />
    <view wx:else class="picker-empty">
      <view class="picker-mark">霞</view>
      <view class="picker-title">选择照片</view>
      <view class="picker-copy subtle-text">支持从相册选择或直接拍摄。</view>
      <view class="upload-format-hint">支持 JPG、PNG、HEIC，建议小于 20MB</view>
    </view>
  </view>

  <view class="form-card xiake-card">
    <view class="metadata-edit-hint">照片信息都可以留空或手动修改；经纬度成对填写后会显示在分享地图。</view>
    <view class="field-group">
      <view class="field-label">拍摄地点</view>
      <input class="field-input" value="{{form.locationName}}" data-field="locationName" placeholder="例如：颐和园十七孔桥" bindinput="onFieldInput" />
    </view>

    <view class="field-row">
      <view class="field-group">
        <view class="field-label">纬度</view>
        <input class="field-input" value="{{form.lat}}" data-field="lat" placeholder="39.9042" bindinput="onFieldInput" />
      </view>
      <view class="field-group">
        <view class="field-label">经度</view>
        <input class="field-input" value="{{form.lon}}" data-field="lon" placeholder="116.4074" bindinput="onFieldInput" />
      </view>
    </view>

    <view class="field-group">
      <view class="field-label">拍摄时间</view>
      <input class="field-input" value="{{form.takenAt}}" data-field="takenAt" placeholder="2026-05-12T19:20:00+08:00" bindinput="onFieldInput" />
    </view>

    <view class="field-group">
      <view class="field-label">上传者</view>
      <input class="field-input" value="{{form.uploaderName}}" data-field="uploaderName" placeholder="你的昵称" bindinput="onFieldInput" />
    </view>

    <view class="field-group">
      <view class="field-label">描述</view>
      <textarea class="field-textarea" value="{{form.desc}}" data-field="desc" placeholder="云层、机位或拍摄感受，可选。" maxlength="160" bindinput="onFieldInput" />
    </view>
  </view>

  <view class="upload-progress xiake-card" wx:if="{{submitting}}">
    <view class="progress-head">
      <text>上传中</text>
      <text>{{progress}}%</text>
    </view>
    <view class="progress-track"><view class="progress-bar" style="width: {{progress}}%;"></view></view>
  </view>

  <view class="error-card" wx:if="{{errorMessage}}">{{errorMessage}}</view>
  <view class="success-card" wx:if="{{successMessage}}">{{successMessage}}</view>

  <view class="action-row">
    <button class="primary-button submit-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitPhoto" hover-class="button-hover" hover-stay-time="80">
      {{submitting ? '正在上传…' : '上传照片'}}
    </button>
    <button class="ghost-button gallery-button" bindtap="goGallery" hover-class="button-hover" hover-stay-time="80">返回图库</button>
  </view>
</view>
