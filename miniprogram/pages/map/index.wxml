<view class="container firecloud-map-page theme-{{resolvedThemeMode}}">
  <app-topbar current="map" period="{{period}}" bind:settingschange="onAppSettingsChange" />

  <view class="map-hero xiake-card xiake-bg-sunset-band">
    <view class="eyebrow warm-accent">Firecloud Map</view>
    <view class="headline">火烧云地图</view>
    <view class="caption">在地图上查看区域火烧云评分图层，颜色越暖表示评分越高。</view>
  </view>

  <view class="map-tabs xiake-card">
    <view class="segment tap-feedback {{period === 'sunrise' ? 'active' : ''}}" data-value="sunrise" bindtap="selectPeriod" hover-class="tap-feedback-hover" hover-stay-time="80">朝霞</view>
    <view class="segment tap-feedback {{period === 'sunset' ? 'active' : ''}}" data-value="sunset" bindtap="selectPeriod" hover-class="tap-feedback-hover" hover-stay-time="80">晚霞</view>
  </view>

  <view class="map-card xiake-card">
    <view class="map-status">
      <view>
        <view class="status-title">{{periodLabel}}地图</view>
        <view class="status-copy">{{updatedAtText}}</view>
      </view>
    </view>

    <view class="map-supported-regions">目前支持：中国大陆、港澳台、日本、韩国；地图使用同源栅格评分插值染色，色带与网页端火烧云图层一致。</view>

    <view class="period-label">{{periodDetailText}}</view>

    <view class="native-map-shell">
      <map
        class="native-map"
        latitude="{{mapCenter.latitude}}"
        longitude="{{mapCenter.longitude}}"
        scale="{{mapScale}}"
        ground-overlays="{{groundOverlays}}"
        polygons="{{polygons}}"
        enable-scroll="{{true}}"
        enable-zoom="{{true}}"
        enable-rotate="{{false}}"
        show-compass="{{true}}"
      />
      <view class="map-loading" wx:if="{{loading}}">
        <view class="loading-copy">正在读取{{periodLabel}}地图</view>
        <view class="loading-track"><view class="loading-fill"></view></view>
      </view>
    </view>

    <view class="map-panel-hint">可拖动地图 · 双指缩放 · 颜色越暖表示评分越高</view>

    <view class="map-legend">
      <view class="legend-title">{{periodLabel}}分数</view>
      <view class="legend-row" wx:for="{{legendItems}}" wx:key="key">
        <view class="legend-swatch legend-{{item.key}}" style="background: {{item.color}};"></view>
        <view class="legend-copy">{{item.label}}</view>
      </view>
    </view>

    <view class="error-card" wx:if="{{errorMessage}}">{{errorMessage}}</view>
  </view>
</view>
