.firecloud-map-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.map-hero,
.map-card {
  padding: 24rpx;
}

.eyebrow {
  color: #f5c87a;
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.headline {
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 900;
}

.caption {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 26rpx;
  line-height: 1.55;
}

.map-tabs {
  display: flex;
  gap: 8rpx;
  width: 332rpx;
  box-sizing: border-box;
  margin: 0 auto;
  padding: 8rpx;
  border: 2rpx solid rgba(127, 83, 29, 0.12);
  border-radius: 999rpx;
  background: rgba(255, 252, 246, 0.72);
  overflow: hidden;
}

.segment {
  flex: 1;
  min-width: 0;
  min-height: 62rpx;
  box-sizing: border-box;
  padding: 0 26rpx;
  border-radius: 999rpx;
  color: rgba(89, 67, 54, 0.62);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 62rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.segment.active {
  color: #ffffff;
  background: linear-gradient(135deg, #f59e0b, #ea8500);
}

.map-status {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.status-title,
.section-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.status-copy {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.50);
  font-size: 23rpx;
}

.map-supported-regions {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(245, 200, 122, 0.16);
  border-radius: 14rpx;
  color: rgba(255, 255, 255, 0.64);
  font-size: 23rpx;
  line-height: 1.55;
  background: rgba(251, 146, 60, 0.08);
}

.period-label {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}

.native-map-shell {
  position: relative;
  overflow: hidden;
  height: 560rpx;
  margin-top: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 18rpx;
  background: rgba(7, 16, 31, 0.58);
}

.native-map {
  width: 100%;
  height: 100%;
}

.map-loading {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  bottom: 22rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  color: rgba(255, 255, 255, 0.70);
  font-size: 25rpx;
  background: rgba(7, 16, 31, 0.72);
}

.map-panel-hint {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.46);
  font-size: 23rpx;
  text-align: center;
}

.map-legend {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: rgba(7, 16, 31, 0.48);
}

.legend-title {
  grid-column: 1 / -1;
  color: rgba(255, 255, 255, 0.72);
  font-size: 23rpx;
  font-weight: 900;
}

.legend-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.legend-swatch {
  width: 28rpx;
  height: 18rpx;
  flex: 0 0 auto;
  border-radius: 4rpx;
}

.legend-copy {
  min-width: 0;
  color: rgba(255, 255, 255, 0.58);
  font-size: 22rpx;
  white-space: nowrap;
}

.legend-excellent {
  background: rgba(249, 115, 22, 0.88);
}

.legend-good {
  background: rgba(251, 146, 60, 0.72);
}

.legend-watch {
  background: rgba(14, 116, 144, 0.72);
}

.loading-track {
  height: 8rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.10);
}

.loading-fill {
  width: 46%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #ffd166, #fb923c);
}

.error-card {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  font-size: 25rpx;
}

.firecloud-map-page.theme-light .map-hero,
.firecloud-map-page.theme-light .map-card {
  border-color: rgba(127, 83, 29, 0.14);
  color: #3d3028;
  background: rgba(255, 252, 246, 0.86);
  box-shadow: 0 18rpx 48rpx rgba(92, 58, 20, 0.12), inset 0 1rpx 0 rgba(255, 255, 255, 0.90);
}

.firecloud-map-page.theme-light .map-hero {
  background: linear-gradient(135deg, rgba(255, 209, 102, 0.32), rgba(251, 146, 60, 0.16) 45%, rgba(255, 252, 246, 0.92) 100%);
}

.firecloud-map-page.theme-light .headline,
.firecloud-map-page.theme-light .status-title {
  color: #3d3028;
}

.firecloud-map-page.theme-light .caption,
.firecloud-map-page.theme-light .status-copy,
.firecloud-map-page.theme-light .period-label,
.firecloud-map-page.theme-light .map-panel-hint,
.firecloud-map-page.theme-light .legend-title,
.firecloud-map-page.theme-light .legend-copy {
  color: rgba(89, 67, 54, 0.66);
}

.firecloud-map-page.theme-light .map-supported-regions {
  border-color: rgba(127, 83, 29, 0.12);
  color: rgba(89, 67, 54, 0.72);
  background: rgba(251, 146, 60, 0.08);
}

.firecloud-map-page.theme-light .native-map-shell,
.firecloud-map-page.theme-light .map-legend {
  border-color: rgba(127, 83, 29, 0.12);
  background: rgba(255, 252, 246, 0.68);
}

.firecloud-map-page.theme-dark .map-hero,
.firecloud-map-page.theme-dark .map-card {
  border-color: rgba(255, 255, 255, 0.10);
  background: rgba(18, 28, 52, 0.82);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.30), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.firecloud-map-page.theme-dark .map-tabs {
  border-color: rgba(255, 255, 255, 0.10);
  background: rgba(7, 16, 31, 0.58);
}

.firecloud-map-page.theme-dark .segment {
  color: rgba(255, 255, 255, 0.62);
}

.firecloud-map-page.theme-dark .segment.active {
  color: #1b1206;
}
