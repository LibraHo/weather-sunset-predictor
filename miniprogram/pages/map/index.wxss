.firecloud-map-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.map-hero,
.map-card,
.spot-list {
  padding: 24rpx;
}

.eyebrow {
  color: #f5c87a;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.12em;
}

.headline {
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 900;
}

.caption {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 26rpx;
  line-height: 1.55;
}

.map-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  padding: 8rpx;
  background: rgba(7, 16, 31, 0.58);
}

.segment {
  height: 72rpx;
  border-radius: 12rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 72rpx;
  text-align: center;
}

.segment.active {
  color: #1b1206;
  background: linear-gradient(135deg, #ffd166, #fb923c);
}

.map-status {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.status-title,
.section-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.status-copy {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.50);
  font-size: 23rpx;
}

.spot-count {
  min-width: 76rpx;
  height: 56rpx;
  border-radius: 999rpx;
  color: #f5c87a;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 56rpx;
  text-align: center;
  background: rgba(251, 146, 60, 0.12);
}

.native-map-shell {
  position: relative;
  overflow: hidden;
  height: 560rpx;
  margin-top: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 18rpx;
  background: rgba(7, 16, 31, 0.58);
}

.native-map {
  width: 100%;
  height: 100%;
}

.map-loading,
.map-empty {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  bottom: 22rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  color: rgba(255, 255, 255, 0.70);
  font-size: 25rpx;
  background: rgba(7, 16, 31, 0.72);
}

.loading-track {
  height: 8rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.10);
}

.loading-fill {
  width: 46%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #ffd166, #fb923c);
}

.error-card {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  font-size: 25rpx;
}

.active-spot {
  display: grid;
  grid-template-columns: 84rpx 1fr 160rpx;
  gap: 16rpx;
  align-items: center;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: rgba(7, 16, 31, 0.52);
}

.active-score,
.row-score {
  border-radius: 14rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  text-align: center;
  background: rgba(148, 163, 184, 0.22);
}

.active-score {
  height: 72rpx;
  line-height: 72rpx;
}

.active-name,
.row-name {
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 900;
}

.active-copy,
.row-copy {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.50);
  font-size: 22rpx;
}

.detail-button {
  height: 66rpx;
  margin: 0;
  font-size: 24rpx;
  line-height: 66rpx;
}

.spot-row {
  display: grid;
  grid-template-columns: 72rpx 1fr;
  gap: 16rpx;
  align-items: center;
  margin-top: 16rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: rgba(7, 16, 31, 0.50);
}

.row-score {
  height: 58rpx;
  line-height: 58rpx;
}

.tone-excellent {
  background: rgba(249, 115, 22, 0.30);
}

.tone-good {
  background: rgba(251, 146, 60, 0.24);
}

.tone-watch {
  background: rgba(14, 116, 144, 0.26);
}
