<scroll-view class="container methodology-page theme-{{resolvedThemeMode}}" scroll-y="true">
  <app-topbar current="{{currentNav}}" theme-mode="{{themeMode}}" resolved-theme-mode="{{resolvedThemeMode}}" bind:settingschange="onAppSettingsChange" />
  <view class="methodology-hero xiake-card app-section-card xiake-bg-sunset-band">
    <view class="eyebrow">{{heroEyebrow}}</view>
    <view class="headline">{{heroTitle}}</view>
    <view class="hero-copy">{{heroCopy}}</view>
  </view>

  <view wx:if="{{!apiOnly}}" class="methodology-section xiake-card app-section-card score-guide-card">
    <view class="section-kicker">Score Guide</view>
    <view class="section-title">评分解读</view>
    <view class="score-list">
      <view class="score-row score-{{item.tone}}" wx:for="{{scoreBands}}" wx:key="range">
        <view class="score-main">
          <text class="score-name">{{item.name}}</text>
          <text class="score-range">{{item.range}}</text>
        </view>
        <view class="score-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!apiOnly}}" class="methodology-section xiake-card app-section-card">
    <view class="section-kicker">Formation</view>
    <view class="section-title">形成条件</view>
    <view class="factor-grid">
      <view class="factor-card" wx:for="{{formationFactors}}" wx:key="title">
        <view class="factor-title">{{item.title}}</view>
        <view class="factor-subtitle">{{item.subtitle}}</view>
        <view class="factor-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!apiOnly}}" class="methodology-section xiake-card app-section-card score-source-card">
    <view class="section-kicker">Map vs Point</view>
    <view class="section-title">地图分 / 地点详情分说明</view>
    <view class="source-item">
      <view class="source-label">地图分</view>
      <view class="source-copy">地图颜色是区域趋势，用来快速看“这一片哪里更可能出彩”。它按固定网格批量计算，并在格点之间做平滑。</view>
    </view>
    <view class="source-item">
      <view class="source-label">地点详情分</view>
      <view class="source-copy">详情分会按你选中的具体坐标，重新看当地日出/日落时间、云层、空气质量和太阳方向。</view>
    </view>
    <view class="source-note">所以地图适合先找方向，地点详情适合最后决定要不要去；如果两者差很多，以地点详情为准。</view>
  </view>

  <view class="methodology-section xiake-card app-section-card api-surface-card">
    <view class="section-kicker">API Access</view>
    <view class="section-title">API接入</view>
    <view class="api-copy">霞客 Agent API 使用 Token 鉴权，适合把地点解析、朝霞 / 晚霞预测、评分解释接入自动化工作流。小程序用户侧天气查询仍走小程序内置服务；这里是开发者接入入口。</view>
    <view class="api-endpoint-list">
      <view class="api-endpoint"><text class="api-path">/api/agent/forecast</text><text>按地点、日期和朝霞 / 晚霞类型返回预测分数、等级和最佳观赏窗口</text></view>
      <view class="api-endpoint"><text class="api-path">/api/agent/explain</text><text>返回评分构成、关键限制、解释文本和可读建议</text></view>
      <view class="api-endpoint"><text class="api-path">/api/agent/geocode</text><text>把输入地点解析为标准名称、国家地区、经纬度和置信度</text></view>
    </view>
    <view class="api-actions">
      <button class="ghost-button api-button" bindtap="copyOpenApiSpec" hover-class="button-hover" hover-stay-time="80">复制 OpenAPI 规格链接</button>
      <button class="ghost-button api-button" bindtap="copyApiApplyLink" hover-class="button-hover" hover-stay-time="80">复制 API 申请入口</button>
    </view>
  </view>

  <view wx:if="{{!apiOnly}}" class="methodology-section xiake-card app-section-card changelog-card">
    <view class="changelog-head">
      <view>
        <view class="section-kicker">Updates</view>
        <view class="section-title">版本更新记录</view>
      </view>
      <view class="changelog-hint">可滚动回看</view>
    </view>
    <scroll-view class="changelog-scroll" scroll-y="true">
      <view class="changelog-item" wx:for="{{changelog}}" wx:key="date">
        <view class="changelog-date">{{item.date}}</view>
        <view class="changelog-body">
          <view class="changelog-title">{{item.title}}</view>
          <view class="changelog-summary">{{item.summary}}</view>
        </view>
      </view>
    </scroll-view>
    <view class="version-card">
      <view class="version-title">当前说明版本</view>
      <view class="version-copy">2026.05.13 · 四因子分析说明；评分口径与 Web 保持一致。</view>
    </view>
  </view>
</scroll-view>
