.gallery-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  background-image: linear-gradient(180deg, rgba(7, 11, 22, 0.12), rgba(14, 25, 48, 0.18));
}

.gallery-hero {
  padding: 12rpx 6rpx 4rpx;
}

.eyebrow {
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.warm-accent {
  color: #f5c87a;
}

.headline {
  margin-top: 16rpx;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.18;
}

.caption {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 26rpx;
  line-height: 1.55;
}

.glass-card {
  background: rgba(18, 28, 52, 0.68);
  backdrop-filter: blur(24rpx);
}

.map-entry {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 26rpx;
}

.map-heading,
.list-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.section-title {
  color: #f5c87a;
  font-size: 28rpx;
  font-weight: 800;
}

.map-copy,
.latest-copy {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.map-count {
  flex: none;
  min-width: 104rpx;
  height: 52rpx;
  border: 1rpx solid rgba(245, 200, 122, 0.22);
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 52rpx;
  text-align: center;
  background: rgba(251, 146, 60, 0.10);
}

.native-map-shell {
  position: relative;
  overflow: hidden;
  height: 420rpx;
  border: 1rpx solid rgba(245, 200, 122, 0.16);
  border-radius: 22rpx;
  background: linear-gradient(160deg, rgba(7, 11, 22, 0.82), rgba(14, 25, 48, 0.86));
}

.native-map {
  width: 100%;
  height: 100%;
}

.map-empty-overlay {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 420rpx;
  max-width: 80%;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 18rpx;
  color: rgba(255, 255, 255, 0.70);
  font-size: 26rpx;
  line-height: 76rpx;
  text-align: center;
  background: rgba(7, 16, 31, 0.72);
}

.active-photo {
  display: flex;
  gap: 18rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: rgba(7, 16, 31, 0.48);
}

.active-thumb,
.active-placeholder {
  flex: none;
  width: 132rpx;
  height: 132rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.active-placeholder {
  color: rgba(245, 200, 122, 0.72);
  font-size: 42rpx;
  font-weight: 900;
  line-height: 132rpx;
  text-align: center;
  background: linear-gradient(135deg, rgba(245, 200, 122, 0.14), rgba(100, 168, 240, 0.10));
}

.active-meta {
  min-width: 0;
  flex: 1;
}

.active-label {
  color: rgba(245, 200, 122, 0.82);
  font-size: 22rpx;
  font-weight: 800;
}

.active-location {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.active-line {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.35;
}

.map-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.map-button,
.retry-button {
  width: 100%;
  margin: 0;
  height: 78rpx;
  line-height: 78rpx;
  font-size: 27rpx;
}

.state-card {
  padding: 30rpx 26rpx;
  border-radius: 16rpx;
}

.error-state {
  border: 1rpx solid rgba(248, 113, 113, 0.28);
  color: #fecaca;
  background: rgba(127, 29, 29, 0.26);
}

.state-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
}

.state-copy {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.retry-button {
  margin-top: 22rpx;
}

.photo-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.list-title {
  margin: 4rpx 0 0;
}

.small-link {
  flex: none;
  min-width: 136rpx;
  height: 58rpx;
  margin: 0;
  border: 1rpx solid rgba(251, 191, 36, 0.18);
  border-radius: 999rpx;
  color: #f5c87a;
  font-size: 24rpx;
  line-height: 58rpx;
  background: rgba(251, 146, 60, 0.10);
}

.photo-card {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
}

.photo-thumb,
.photo-placeholder {
  flex: none;
  width: 156rpx;
  height: 156rpx;
  border-radius: 14rpx;
  overflow: hidden;
}

.photo-placeholder {
  color: rgba(245, 200, 122, 0.72);
  font-size: 44rpx;
  font-weight: 900;
  line-height: 156rpx;
  text-align: center;
  background: linear-gradient(135deg, rgba(245, 200, 122, 0.12), rgba(100, 168, 240, 0.10));
}

.photo-meta {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.photo-location {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
}

.photo-line {
  font-size: 24rpx;
  line-height: 1.35;
}

.card-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}

.inline-button {
  min-width: 112rpx;
  height: 52rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid rgba(251, 191, 36, 0.18);
  border-radius: 999rpx;
  color: #f5c87a;
  font-size: 23rpx;
  line-height: 52rpx;
  background: rgba(251, 146, 60, 0.10);
}
