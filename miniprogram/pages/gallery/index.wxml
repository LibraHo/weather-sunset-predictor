<view class="container gallery-page theme-{{resolvedThemeMode}}">
  <app-topbar current="gallery" theme-mode="{{themeMode}}" resolved-theme-mode="{{resolvedThemeMode}}" bind:settingschange="onAppSettingsChange" />
  <view class="gallery-hero">
    <view class="eyebrow warm-accent">霞客影集</view>
    <view class="headline">照片分享地图</view>
    <view class="caption">在小程序里直接看照片、位置和详情；需要大屏浏览时再打开 H5 地图。</view>
  </view>

  <view class="map-entry xiake-card glass-card">
    <view class="map-heading">
      <view>
        <view class="section-title">{{mapStatus.title}}</view>
        <view class="map-copy subtle-text">{{mapStatus.description}}</view>
      </view>
      <view class="map-count warm-accent">{{photoStats.withLocation}}/{{photoStats.total}}</view>
    </view>

    <view class="native-map-shell">
      <map
        wx:if="{{photoStats.withLocation}}"
        class="native-map"
        latitude="{{mapCenter.latitude}}"
        longitude="{{mapCenter.longitude}}"
        scale="{{mapScale}}"
        markers="{{mapMarkers}}"
        bindmarkertap="focusPhoto"
      />
      <view class="map-empty-overlay" wx:if="{{!photoStats.withLocation && !loading}}">等待带位置的霞光照片</view>
      <view class="map-legend">
        <view class="legend-photo-dot"></view>
        <view class="legend-text">照片位置</view>
      </view>
    </view>

    <view class="active-photo" wx:if="{{activePhoto}}">
      <image wx:if="{{activePhoto.hasThumbnail}}" class="active-thumb tap-feedback" src="{{activePhoto.thumbnailUrl}}" mode="aspectFill" bindtap="previewOriginal" data-id="{{activePhoto.id}}" hover-class="tap-feedback-hover" hover-stay-time="80" />
      <view wx:else class="active-placeholder">霞</view>
      <view class="active-meta">
        <view class="active-label">当前照片</view>
        <view class="active-location">{{activePhoto.location}}</view>
        <view class="active-line subtle-text">{{activePhoto.coordinatesText}}</view>
        <view class="active-line subtle-text">{{activePhoto.takenAt}} · {{activePhoto.uploader}}</view>
        <view class="active-line active-uploaded-at subtle-text">上传时间：{{activePhoto.uploadedAt}}</view>
      </view>
    </view>

    <view class="map-actions">
      <button class="primary-button map-button" bindtap="goUpload" hover-class="button-hover" hover-stay-time="80">上传照片</button>
      <button class="ghost-button map-button" bindtap="previewOriginal" wx:if="{{activePhoto}}" hover-class="button-hover" hover-stay-time="80">查看原图</button>
      <button class="ghost-button map-button" bindtap="copyPhotoLink" wx:if="{{activePhoto}}" hover-class="button-hover" hover-stay-time="80">复制照片链接</button>
      <button class="ghost-button map-button" bindtap="copyGalleryLink" hover-class="button-hover" hover-stay-time="80">复制 H5 地图</button>
    </view>
  </view>

  <view class="state-card xiake-card" wx:if="{{loading}}">
    <view class="state-title">正在加载照片…</view>
    <view class="state-copy subtle-text">照片马上回来。</view>
  </view>

  <view class="state-card error-state" wx:elif="{{errorMessage}}">
    <view class="state-title">加载失败</view>
    <view class="state-copy">{{errorMessage}}</view>
    <button class="ghost-button retry-button" bindtap="loadPhotos" hover-class="button-hover" hover-stay-time="80">重试</button>
  </view>

  <view class="state-card xiake-card empty-state" wx:elif="{{isEmpty}}">
    <view class="state-title">暂无照片</view>
    <view class="state-copy subtle-text">上传第一张火烧云照片吧。</view>
    <button class="primary-button retry-button" bindtap="goUpload" hover-class="button-hover" hover-stay-time="80">上传照片</button>
  </view>

  <view class="photo-list" wx:else>
    <view class="list-header">
      <view>
        <view class="section-title list-title">最新照片</view>
        <view class="latest-copy subtle-text" wx:if="{{latestPhoto}}">最近：{{latestPhoto.location}} · {{latestPhoto.takenAt}}</view>
      </view>
      <button class="small-link" bindtap="copyGalleryLink" hover-class="button-hover" hover-stay-time="80">H5 地图</button>
    </view>

    <view class="photo-card xiake-card glass-card tap-feedback" wx:for="{{photos}}" wx:key="id" bindtap="focusPhoto" data-id="{{item.id}}" hover-class="card-tap-hover" hover-stay-time="80">
      <image wx:if="{{item.hasThumbnail}}" class="photo-thumb" src="{{item.thumbnailUrl}}" mode="aspectFill" />
      <view wx:else class="photo-placeholder">霞</view>
      <view class="photo-meta">
        <view class="photo-location">{{item.location}}</view>
        <view class="photo-line subtle-text">拍摄时间：{{item.takenAt}}</view>
        <view class="photo-line subtle-text">位置：{{item.coordinatesText}}</view>
        <view class="photo-line photo-uploaded-at subtle-text">上传时间：{{item.uploadedAt}}</view>
        <view class="photo-line subtle-text">上传者：{{item.uploader}}</view>
        <view class="card-actions">
          <button class="inline-button" catchtap="previewOriginal" data-id="{{item.id}}">原图</button>
          <button class="inline-button" catchtap="copyPhotoLink" data-id="{{item.id}}">复制链接</button>
        </view>
      </view>
    </view>
  </view>
</view>
