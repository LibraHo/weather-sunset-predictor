.user-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.user-hero-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(127, 83, 29, 0.15);
  border-radius: 24rpx;
  background: rgba(255, 252, 246, 0.90);
  box-shadow: 0 28rpx 76rpx rgba(92, 58, 20, 0.10), inset 0 1rpx 0 rgba(255, 255, 255, 0.90);
}

.user-avatar {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 24rpx;
  color: #7a4a18;
  background: linear-gradient(135deg, rgba(255, 209, 102, 0.40), rgba(251, 146, 60, 0.22));
}

.user-avatar-icon {
  width: 58rpx;
  height: 58rpx;
  display: block;
}

.user-hero-copy {
  min-width: 0;
  flex: 1;
}

.user-kicker {
  color: #d97706;
  font-size: 23rpx;
  font-weight: 900;
}

.user-title {
  margin-top: 8rpx;
  color: #3d3028;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.22;
}

.user-subtitle {
  margin-top: 10rpx;
  color: rgba(89, 67, 54, 0.68);
  font-size: 25rpx;
  line-height: 1.45;
}

.user-actions {
  display: grid;
  grid-template-columns: 1fr;
}

.user-action-primary,
.user-action-secondary,
.user-inline-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 80rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
}

.user-action-primary {
  color: #1b1206;
  background: linear-gradient(135deg, #ffd166, #fb923c);
  box-shadow: 0 18rpx 42rpx rgba(251, 146, 60, 0.25);
}

.user-action-secondary,
.user-inline-button {
  color: #7a4a18;
  border: 1rpx solid rgba(127, 83, 29, 0.16);
  background: rgba(255, 255, 255, 0.72);
}

.user-action-primary::after,
.user-action-secondary::after,
.user-inline-button::after {
  border: 0;
}

.user-session-card,
.user-state-card,
.user-section-card {
  padding: 26rpx;
  border: 2rpx solid rgba(127, 83, 29, 0.15);
  border-radius: 24rpx;
  background: rgba(255, 252, 246, 0.90);
  box-shadow: 0 28rpx 76rpx rgba(92, 58, 20, 0.10), inset 0 1rpx 0 rgba(255, 255, 255, 0.90);
}

.user-session-title,
.user-state-title,
.user-section-title {
  color: #3d3028;
  font-size: 30rpx;
  font-weight: 900;
}

.user-session-copy,
.user-state-copy,
.user-section-subtitle {
  margin-top: 8rpx;
  color: rgba(89, 67, 54, 0.66);
  font-size: 24rpx;
  line-height: 1.45;
}

.user-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.user-count {
  flex: none;
  min-width: 58rpx;
  height: 46rpx;
  border-radius: 999rpx;
  color: #7a4a18;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 46rpx;
  text-align: center;
  background: rgba(217, 119, 6, 0.12);
}

.user-location-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 84rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(127, 83, 29, 0.12);
}

.user-location-main {
  min-width: 0;
  flex: 1;
}

.user-location-name {
  overflow: hidden;
  color: #3d3028;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-location-meta {
  margin-top: 8rpx;
  color: rgba(89, 67, 54, 0.62);
  font-size: 23rpx;
  line-height: 1.35;
}

.user-row-chevron {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid rgba(122, 74, 24, 0.52);
  border-right: 4rpx solid rgba(122, 74, 24, 0.52);
  transform: rotate(45deg);
}

.user-empty {
  padding: 30rpx 0 6rpx;
  color: rgba(89, 67, 54, 0.62);
  font-size: 25rpx;
  line-height: 1.45;
}

.user-page.theme-dark .user-hero-card,
.user-page.theme-dark .user-session-card,
.user-page.theme-dark .user-state-card,
.user-page.theme-dark .user-section-card {
  border-color: rgba(255, 255, 255, 0.10);
  background: rgba(18, 28, 52, 0.86);
  box-shadow: 0 28rpx 76rpx rgba(0, 0, 0, 0.32), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.user-page.theme-dark .user-avatar {
  background: rgba(251, 146, 60, 0.14);
}

.user-page.theme-dark .user-kicker,
.user-page.theme-dark .user-session-title,
.user-page.theme-dark .user-section-title,
.user-page.theme-dark .user-state-title {
  color: #f5c87a;
}

.user-page.theme-dark .user-title,
.user-page.theme-dark .user-location-name {
  color: #ffffff;
}

.user-page.theme-dark .user-subtitle,
.user-page.theme-dark .user-session-copy,
.user-page.theme-dark .user-state-copy,
.user-page.theme-dark .user-section-subtitle,
.user-page.theme-dark .user-location-meta,
.user-page.theme-dark .user-empty {
  color: rgba(255, 255, 255, 0.66);
}

.user-page.theme-dark .user-action-secondary,
.user-page.theme-dark .user-inline-button {
  color: #f5c87a;
  border-color: rgba(255, 255, 255, 0.10);
  background: rgba(255, 255, 255, 0.08);
}

.user-page.theme-dark .user-count {
  color: #f5c87a;
  background: rgba(251, 146, 60, 0.14);
}

.user-page.theme-dark .user-location-row {
  border-top-color: rgba(255, 255, 255, 0.08);
}

.user-page.theme-dark .user-row-chevron {
  border-color: rgba(245, 200, 122, 0.58);
}
