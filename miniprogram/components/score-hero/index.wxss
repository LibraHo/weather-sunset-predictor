.score-hero {
  padding: 34rpx 32rpx;
  overflow: hidden;
  background: linear-gradient(142deg, rgba(251, 146, 60, 0.18) 0%, rgba(18, 28, 52, 0.78) 46%, rgba(10, 15, 30, 0.92) 100%);
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.eyebrow {
  color: rgba(255, 255, 255, 0.52);
  font-size: 24rpx;
}

.location {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 800;
}

.grade {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.grade-hot { color: #1b1206; background: #ffd166; }
.grade-good { color: #fff7df; background: rgba(251, 146, 60, 0.28); }
.grade-fair { color: #e8eefb; background: rgba(148, 163, 184, 0.22); }
.grade-low, .grade-waiting { color: rgba(255, 255, 255, 0.62); background: rgba(255, 255, 255, 0.10); }

.score-line {
  margin-top: 22rpx;
}

.score {
  color: #ffd166;
  font-size: 126rpx;
  font-weight: 900;
  line-height: 1;
  text-shadow: 0 0 34rpx rgba(251, 146, 60, 0.25);
}

.unit {
  margin-left: 8rpx;
  color: rgba(255, 255, 255, 0.56);
  font-size: 30rpx;
}

.window {
  margin-top: 18rpx;
  color: #fdba74;
  font-size: 28rpx;
  font-weight: 700;
}

.explain {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 27rpx;
  line-height: 1.58;
}
