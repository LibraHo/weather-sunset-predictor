<view class="app-topbar-shell theme-{{resolvedThemeMode}} theme-setting-{{themeMode}}">
  <view class="home-topbar">
    <view class="home-brand-row tap-feedback" hover-class="tap-feedback-hover" hover-stay-time="80" bindtap="goHome">
      <image class="app-logo-image" src="/assets/icons/xiake-logo.svg" mode="aspectFit" aria-hidden="true" />
      <view class="app-logo-text">霞客</view>
    </view>

    <view class="home-header-actions">
      <view class="home-view-menu">
        <button class="menu-button icon-button" aria-label="menu" hover-class="button-hover" hover-stay-time="80" bindtap="toggleHomeMenu">
          <image class="header-action-image" src="/assets/icons/menu.svg" mode="aspectFit" aria-hidden="true" />
        </button>
        <view class="home-view-menu-dropdown" wx:if="{{homeMenuOpen}}">
          <view class="home-view-option tap-feedback {{current === 'home' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-target="forecast" bindtap="navigateFeature">预测功能</view>
          <view class="home-view-option tap-feedback {{current === 'simulator' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-target="simulator" bindtap="navigateFeature">火烧云模拟器</view>
          <view class="home-view-option tap-feedback {{current === 'methodology' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-target="methodology" bindtap="navigateFeature">火烧云算法</view>
          <view class="home-view-option tap-feedback {{current === 'map' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-target="map" bindtap="navigateFeature">火烧云地图</view>
          <view class="home-view-option tap-feedback {{current === 'gallery' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-target="gallery" bindtap="navigateFeature">分享地图</view>
          <view class="home-view-option tap-feedback {{current === 'user' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-target="user" bindtap="navigateFeature">我的</view>
        </view>
      </view>
      <button class="header-icon-button icon-button" aria-label="notice">
        <image class="header-action-image" src="/assets/icons/bell.svg" mode="aspectFit" aria-hidden="true" />
      </button>
      <button class="header-icon-button icon-button" aria-label="settings" hover-class="button-hover" hover-stay-time="80" bindtap="toggleSettings">
        <image class="header-action-image" src="/assets/icons/settings.svg" mode="aspectFit" aria-hidden="true" />
      </button>
    </view>
  </view>

  <view class="settings-panel xiake-card" wx:if="{{settingsOpen}}">
    <view class="settings-panel-head">
      <view>
        <view class="settings-title">设置</view>
        <view class="settings-subtitle">调整界面语言、显示主题和天气单位。</view>
      </view>
      <button class="settings-close" aria-label="close settings" hover-class="button-hover" hover-stay-time="80" bindtap="closeSettings">×</button>
    </view>
    <view class="settings-group">
      <view class="settings-label">界面语言</view>
      <view class="settings-segmented">
        <view class="settings-segment tap-feedback {{interfaceLanguage === 'zh-CN' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-value="zh-CN" bindtap="selectInterfaceLanguage">中文</view>
        <view class="settings-segment tap-feedback {{interfaceLanguage === 'en-US' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-value="en-US" bindtap="selectInterfaceLanguage">English</view>
      </view>
    </view>
    <view class="settings-group">
      <view class="settings-label">显示主题</view>
      <view class="settings-segmented">
        <view class="settings-segment tap-feedback {{themeMode === 'system' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-value="system" bindtap="selectThemeMode">跟随系统</view>
        <view class="settings-segment tap-feedback {{themeMode === 'light' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-value="light" bindtap="selectThemeMode">浅色</view>
        <view class="settings-segment tap-feedback {{themeMode === 'dark' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-value="dark" bindtap="selectThemeMode">深色</view>
      </view>
    </view>
    <view class="settings-group">
      <view class="settings-label">温度单位</view>
      <view class="settings-segmented">
        <view class="settings-segment tap-feedback {{temperatureUnit === 'celsius' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-value="celsius" bindtap="selectTemperatureUnit">°C</view>
        <view class="settings-segment tap-feedback {{temperatureUnit === 'fahrenheit' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-value="fahrenheit" bindtap="selectTemperatureUnit">°F</view>
      </view>
    </view>
    <view class="settings-group">
      <view class="settings-label">风速单位</view>
      <view class="settings-segmented">
        <view class="settings-segment tap-feedback {{windSpeedUnit === 'kmh' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-value="kmh" bindtap="selectWindSpeedUnit">km/h</view>
        <view class="settings-segment tap-feedback {{windSpeedUnit === 'ms' ? 'active' : ''}}" hover-class="tap-feedback-hover" hover-stay-time="80" data-value="ms" bindtap="selectWindSpeedUnit">m/s</view>
      </view>
    </view>
    <button class="settings-done" hover-class="button-hover" hover-stay-time="80" bindtap="closeSettings">保存</button>
  </view>
</view>
