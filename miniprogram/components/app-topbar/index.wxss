.app-topbar-shell {
  position: relative;
  z-index: 20;
  flex: none;
}

.home-topbar {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 132rpx;
  box-sizing: border-box;
  padding: 28rpx 30rpx;
  border: 2rpx solid rgba(127, 83, 29, 0.15);
  border-radius: 24rpx;
  background: rgba(255, 252, 246, 0.90);
  box-shadow: 0 28rpx 76rpx rgba(92, 58, 20, 0.10), inset 0 1rpx 0 rgba(255, 255, 255, 0.90);
}

.home-brand-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.app-logo-image {
  width: 74rpx;
  height: 74rpx;
  display: block;
}

.app-logo-text {
  color: #7a4a18;
  font-family: "Cormorant Garamond", Georgia, "Songti SC", "STSong", serif;
  font-size: 42rpx;
  font-weight: 500;
  letter-spacing: 0;
  line-height: 1;
}

.home-header-actions {
  display: flex;
  flex: none;
  align-items: center;
  gap: 12rpx;
}

.home-view-menu {
  position: relative;
  flex: none;
}

.icon-button,
.menu-button,
.header-icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 20rpx;
  color: #6a421d;
  line-height: 1;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 12rpx 26rpx rgba(92, 58, 20, 0.10);
}

.menu-button,
.header-icon-button {
  width: 70rpx;
  min-width: 70rpx;
  max-width: 70rpx;
  height: 70rpx;
  box-sizing: border-box;
}

.header-action-image {
  width: 42rpx;
  height: 42rpx;
  display: block;
}

.home-view-menu-dropdown {
  position: absolute;
  top: 82rpx;
  right: 0;
  width: 286rpx;
  box-sizing: border-box;
  padding: 10rpx;
  border: 1rpx solid rgba(127, 83, 29, 0.14);
  border-radius: 16rpx;
  background: rgba(255, 252, 246, 0.98);
  box-shadow: 0 18rpx 46rpx rgba(92, 58, 20, 0.16);
}

.home-view-option {
  min-height: 56rpx;
  box-sizing: border-box;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  color: #6f5d51;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 32rpx;
}

.home-view-option.active {
  color: #4f2f0f;
  background: linear-gradient(135deg, #ffd166 0%, #fb923c 70%, #f97316 100%);
  box-shadow: 0 8rpx 18rpx rgba(251, 146, 60, 0.24);
}

.settings-panel {
  position: relative;
  margin-top: 18rpx;
  padding: 24rpx;
  color: #3d3028;
  border: 2rpx solid rgba(127, 83, 29, 0.15);
  border-radius: 24rpx;
  background: rgba(255, 252, 246, 0.90);
  box-shadow: 0 28rpx 76rpx rgba(92, 58, 20, 0.10), inset 0 1rpx 0 rgba(255, 255, 255, 0.90);
}

.settings-panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding-right: 64rpx;
}

.settings-title {
  color: #3d3028;
  font-size: 32rpx;
  font-weight: 900;
}

.settings-subtitle {
  margin-top: 6rpx;
  color: rgba(89, 67, 54, 0.66);
  font-size: 23rpx;
  line-height: 1.45;
}

.settings-close {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: rgba(89, 67, 54, 0.82);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
  background: rgba(127, 83, 29, 0.10);
}

.settings-group {
  margin-top: 22rpx;
}

.settings-label {
  color: #7a4a18;
  font-size: 24rpx;
  font-weight: 800;
}

.settings-segmented {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
  padding: 7rpx;
  border-radius: 14rpx;
  background: rgba(127, 83, 29, 0.08);
}

.settings-segment {
  flex: 1;
  height: 62rpx;
  border-radius: 10rpx;
  color: rgba(89, 67, 54, 0.62);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 62rpx;
  text-align: center;
}

.settings-segment.active {
  color: #4f2f0f;
  background: linear-gradient(135deg, #ffd166 0%, #fb923c 70%, #f97316 100%);
  box-shadow: 0 8rpx 18rpx rgba(251, 146, 60, 0.24);
}

.settings-done {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 72rpx;
  margin-top: 26rpx;
  padding: 0;
  border-radius: 14rpx;
  color: #1b1206;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
  background: linear-gradient(135deg, #ffd166, #fb923c);
}

.menu-button::after,
.header-icon-button::after,
.settings-close::after,
.settings-done::after {
  border: 0;
}

.app-topbar-shell.theme-dark .home-topbar {
  border-color: rgba(255, 255, 255, 0.10);
  background: rgba(18, 28, 52, 0.90);
  box-shadow: 0 28rpx 76rpx rgba(0, 0, 0, 0.32), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.app-topbar-shell.theme-dark .app-logo-text {
  color: #f5c87a;
}

.app-topbar-shell.theme-dark .icon-button,
.app-topbar-shell.theme-dark .menu-button,
.app-topbar-shell.theme-dark .header-icon-button {
  color: #f5c87a;
  background: rgba(255, 255, 255, 0.08);
  box-shadow: 0 12rpx 26rpx rgba(0, 0, 0, 0.24);
}

.app-topbar-shell.theme-dark .home-view-menu-dropdown,
.app-topbar-shell.theme-dark .settings-panel {
  border-color: rgba(255, 255, 255, 0.10);
  background: rgba(18, 28, 52, 0.96);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.36), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.app-topbar-shell.theme-dark .home-view-option,
.app-topbar-shell.theme-dark .settings-segment {
  color: rgba(255, 255, 255, 0.70);
}

.app-topbar-shell.theme-dark .home-view-option.active,
.app-topbar-shell.theme-dark .settings-segment.active {
  color: #1b1206;
}

.app-topbar-shell.theme-dark .settings-title {
  color: #ffffff;
}

.app-topbar-shell.theme-dark .settings-subtitle,
.app-topbar-shell.theme-dark .settings-close {
  color: rgba(255, 255, 255, 0.62);
}

.app-topbar-shell.theme-dark .settings-label {
  color: #f5c87a;
}

.app-topbar-shell.theme-dark .settings-segmented {
  background: rgba(7, 16, 31, 0.62);
}
