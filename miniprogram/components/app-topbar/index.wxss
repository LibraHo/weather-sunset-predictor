.app-topbar-shell {
  position: relative;
  z-index: 20;
  flex: none;
}

.home-topbar {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  padding: 4rpx 4rpx 0;
}

.home-brand-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.app-logo-image {
  width: 52rpx;
  height: 52rpx;
  display: block;
}

.app-logo-text {
  color: #7a4a18;
  font-family: "Cormorant Garamond", Georgia, "Songti SC", "STSong", serif;
  font-size: 42rpx;
  font-weight: 300;
  letter-spacing: 0;
  line-height: 1;
}

.home-header-actions {
  display: flex;
  flex: none;
  align-items: center;
  gap: 12rpx;
}

.home-view-menu {
  position: relative;
  flex: none;
}

.icon-button,
.menu-button,
.header-icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 12rpx 28rpx rgba(64, 39, 13, 0.12);
}

.menu-button,
.header-icon-button {
  width: 70rpx;
  height: 70rpx;
}

.header-action-image {
  width: 38rpx;
  height: 38rpx;
  display: block;
}

.home-view-menu-dropdown {
  position: absolute;
  top: 82rpx;
  right: 0;
  width: 244rpx;
  box-sizing: border-box;
  padding: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  background: rgba(10, 15, 30, 0.96);
  box-shadow: 0 18rpx 46rpx rgba(0, 0, 0, 0.34);
}

.home-view-option {
  min-height: 56rpx;
  box-sizing: border-box;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 32rpx;
}

.home-view-option.active {
  color: #1b1206;
  background: linear-gradient(135deg, #ffd166, #fb923c);
}

.settings-panel {
  margin-top: 18rpx;
  padding: 24rpx;
}

.settings-panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.settings-title {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
}

.settings-subtitle {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.48);
  font-size: 23rpx;
  line-height: 1.45;
}

.settings-close {
  width: 52rpx;
  height: 52rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 34rpx;
  line-height: 46rpx;
  background: rgba(255, 255, 255, 0.08);
}

.settings-group {
  margin-top: 22rpx;
}

.settings-label {
  color: #f5c87a;
  font-size: 24rpx;
  font-weight: 800;
}

.settings-segmented {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
  padding: 7rpx;
  border-radius: 14rpx;
  background: rgba(7, 16, 31, 0.52);
}

.settings-segment {
  flex: 1;
  height: 62rpx;
  border-radius: 10rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 62rpx;
  text-align: center;
}

.settings-segment.active {
  color: #1b1206;
  background: linear-gradient(135deg, #ffd166, #fb923c);
}

.settings-done {
  width: 100%;
  height: 72rpx;
  margin-top: 26rpx;
  border-radius: 14rpx;
  color: #1b1206;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 72rpx;
  background: linear-gradient(135deg, #ffd166, #fb923c);
}

button::after {
  border: 0;
}
