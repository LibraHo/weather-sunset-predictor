.location-search {
  padding: 22rpx;
}

.field-label {
  margin-bottom: 14rpx;
  color: #f5c87a;
  font-size: 24rpx;
  font-weight: 800;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.location-input {
  flex: 1;
  height: 76rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 12rpx;
  color: rgba(255, 255, 255, 0.94);
  background: rgba(7, 16, 31, 0.54);
  font-size: 28rpx;
}

.input-placeholder {
  color: rgba(255, 255, 255, 0.36);
}

.locate-button {
  width: 132rpx;
  height: 76rpx;
  margin: 0;
  border-radius: 12rpx;
  color: #1b1206;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 76rpx;
  background: linear-gradient(135deg, rgba(255, 209, 102, 0.95), rgba(251, 146, 60, 0.92));
}
