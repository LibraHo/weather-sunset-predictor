.location-search {
  padding: 42rpx 32rpx 50rpx;
  border: 2rpx solid rgba(127, 83, 29, 0.16);
  border-radius: 24rpx;
  background: rgba(255, 252, 246, 0.86);
  box-shadow: 0 28rpx 76rpx rgba(92, 58, 20, 0.10), inset 0 1rpx 0 rgba(255, 255, 255, 0.90);
}

.field-label {
  margin-bottom: 30rpx;
  color: #3d3028;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.1;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
  padding: 14rpx 16rpx;
  border: 2rpx solid rgba(127, 83, 29, 0.14);
  border-radius: 22rpx;
  background: rgba(255, 252, 247, 0.94);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}

.favorite-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 80rpx !important;
  min-width: 0 !important;
  max-width: 80rpx !important;
  flex-basis: 80rpx !important;
  height: 80rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 2rpx solid rgba(127, 83, 29, 0.12);
  border-radius: 18rpx;
  color: #f0b429;
  font-size: 36rpx;
  line-height: 1;
  background: #fffaf2;
}

.star-icon {
  width: 34rpx;
  height: 34rpx;
  filter: drop-shadow(0 4rpx 10rpx rgba(240, 180, 41, 0.34));
}

.location-input-shell {
  position: relative;
  flex: 1;
  min-width: 0;
  z-index: 5;
}

.location-input {
  width: 100%;
  height: 80rpx;
  box-sizing: border-box;
  padding: 0 54rpx 0 26rpx;
  border: 2rpx solid rgba(127, 83, 29, 0.12);
  border-radius: 18rpx;
  color: #6f5d51;
  background: rgba(255, 255, 255, 0.62);
  font-size: 32rpx;
}

.input-placeholder {
  color: rgba(89, 67, 54, 0.62);
}

.pin-location-button {
  position: absolute;
  right: 4rpx;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx !important;
  min-width: 0 !important;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: 2rpx solid rgba(127, 83, 29, 0.12);
  border-radius: 16rpx;
  background: rgba(255, 250, 242, 0.86);
  box-shadow: 0 8rpx 24rpx rgba(122, 74, 18, 0.12);
  transform: translateY(-50%);
}

.pin-location-button::after {
  border: 0;
}

.pin-icon-image {
  display: block;
  width: 34rpx;
  height: 34rpx;
}

.location-query-button {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 150rpx !important;
  min-width: 0 !important;
  max-width: 150rpx !important;
  flex-basis: 150rpx !important;
  height: 80rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
  background: #39a849;
  box-shadow: 0 16rpx 30rpx rgba(57, 168, 73, 0.22);
}

.location-query-button.is-disabled {
  color: rgba(255, 255, 255, 0.84);
  background: linear-gradient(135deg, #ffd166, #fb923c);
  box-shadow: 0 12rpx 26rpx rgba(251, 146, 60, 0.22);
}

.announcement-entry {
  display: flex;
  align-items: center;
  min-height: 68rpx;
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 0 22rpx;
  border: 2rpx solid rgba(127, 83, 29, 0.14);
  border-radius: 18rpx;
  background: rgba(255, 252, 247, 0.94);
}

.announcement-entry-label {
  flex: none;
  margin-right: 18rpx;
  padding-right: 18rpx;
  border-right: 2rpx solid rgba(127, 83, 29, 0.12);
  color: #b66a16;
  font-size: 24rpx;
  font-weight: 900;
}

.announcement-entry-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #3d3028;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-suggestion-dropdown {
  position: absolute;
  left: 0;
  right: 0;
  top: calc(100% - 2rpx);
  z-index: 20;
  max-height: 360rpx;
  overflow-y: auto;
  box-sizing: border-box;
  border: 2rpx solid rgba(127, 83, 29, 0.14);
  border-top: 0;
  border-radius: 0 0 18rpx 18rpx;
  background: rgba(255, 252, 247, 0.98);
  box-shadow: 0 22rpx 44rpx rgba(92, 58, 20, 0.16);
}

.location-suggestion-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  box-sizing: border-box;
  min-height: 76rpx;
  padding: 16rpx 20rpx;
  border-bottom: 2rpx solid rgba(127, 83, 29, 0.10);
}

.location-suggestion-item:last-child {
  border-bottom: 0;
}

.location-suggestion-pin {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-top: 3rpx;
}

.location-suggestion-copy {
  flex: 1;
  min-width: 0;
}

.location-suggestion-name {
  color: #3d3028;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.25;
}

.location-suggestion-meta {
  margin-top: 4rpx;
  color: rgba(89, 67, 54, 0.62);
  font-size: 22rpx;
  line-height: 1.25;
}

.location-search.theme-dark {
  border-color: rgba(255, 255, 255, 0.10);
  background: rgba(18, 28, 52, 0.86);
  box-shadow: 0 20rpx 58rpx rgba(0, 0, 0, 0.32), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.location-search.theme-dark .field-label {
  color: #ffffff;
}

.location-search.theme-dark .input-row {
  border-color: rgba(255, 255, 255, 0.10);
  background: rgba(7, 16, 31, 0.62);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.location-search.theme-dark .favorite-icon,
.location-search.theme-dark .location-input {
  border-color: rgba(255, 255, 255, 0.10);
  background: rgba(255, 255, 255, 0.07);
}

.location-search.theme-dark .location-input {
  color: rgba(255, 255, 255, 0.90);
}

.location-search.theme-dark .input-placeholder {
  color: rgba(255, 255, 255, 0.42);
}

.location-search.theme-dark .pin-location-button {
  border-color: rgba(251, 191, 36, 0.18);
  background: rgba(251, 146, 60, 0.10);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.06), 0 16rpx 36rpx rgba(0, 0, 0, 0.24);
}

.location-search.theme-dark .location-suggestion-dropdown {
  border-color: rgba(255, 255, 255, 0.10);
  background: rgba(14, 24, 46, 0.98);
  box-shadow: 0 24rpx 48rpx rgba(0, 0, 0, 0.34);
}

.location-search.theme-dark .location-suggestion-item {
  border-bottom-color: rgba(255, 255, 255, 0.08);
}

.location-search.theme-dark .location-suggestion-name {
  color: rgba(255, 255, 255, 0.94);
}

.location-search.theme-dark .location-suggestion-meta {
  color: rgba(226, 232, 240, 0.64);
}

.location-search.theme-dark .announcement-entry {
  border-color: rgba(255, 255, 255, 0.10);
  background: rgba(255, 255, 255, 0.07);
}

.location-search.theme-dark .announcement-entry-label {
  border-right-color: rgba(255, 255, 255, 0.10);
  color: #f5c87a;
}

.location-search.theme-dark .announcement-entry-text {
  color: rgba(255, 255, 255, 0.90);
}
