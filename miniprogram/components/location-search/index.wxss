.location-search {
  padding: 26rpx;
}

.field-label {
  margin-bottom: 16rpx;
  color: #f5c87a;
  font-size: 26rpx;
  font-weight: 700;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.location-input {
  flex: 1;
  height: 78rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 14rpx;
  color: rgba(255, 255, 255, 0.94);
  background: rgba(7, 16, 31, 0.54);
  font-size: 30rpx;
}

.input-placeholder {
  color: rgba(255, 255, 255, 0.36);
}

.locate-button {
  width: 176rpx;
  height: 78rpx;
  margin: 0;
  border-radius: 14rpx;
  color: #f5c87a;
  font-size: 26rpx;
  line-height: 78rpx;
  background: rgba(251, 146, 60, 0.12);
}
