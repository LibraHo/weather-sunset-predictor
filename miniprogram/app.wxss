page {
  min-height: 100%;
  color: rgba(255, 255, 255, 0.92);
  background-color: #0a0f1e;
  background-image:
    radial-gradient(circle at 20% 8%, rgba(255, 184, 107, 0.22) 0, transparent 34%),
    radial-gradient(circle at 85% 0%, rgba(100, 168, 240, 0.18) 0, transparent 30%),
    radial-gradient(circle at 12% 76%, rgba(167, 139, 250, 0.16) 0, transparent 34%),
    linear-gradient(180deg, #0a0f1e 0%, #0e1930 54%, #07101f 100%);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx 56rpx;
}

.xiake-card {
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 16rpx;
  background: rgba(18, 28, 52, 0.66);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.30), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(24rpx);
}

.glow-title {
  color: #f5c87a;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.subtle-text {
  color: rgba(255, 255, 255, 0.58);
}

.primary-button {
  height: 96rpx;
  border: 0;
  border-radius: 16rpx;
  color: #1b1206;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 96rpx;
  background: linear-gradient(135deg, #ffd166 0%, #fb923c 58%, #f97316 100%);
  box-shadow: 0 16rpx 34rpx rgba(251, 146, 60, 0.28);
}

.primary-button[disabled] {
  color: rgba(255, 255, 255, 0.52);
  background: rgba(255, 255, 255, 0.12);
  box-shadow: none;
}

.ghost-button {
  border: 1rpx solid rgba(251, 191, 36, 0.18);
  border-radius: 14rpx;
  color: #f5c87a;
  background: rgba(251, 146, 60, 0.10);
}

button::after {
  border: 0;
}
